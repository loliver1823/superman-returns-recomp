CASE sub_8211BBE0_stack_outptr
W 70EFF000 AAAAAAAA
CALL 8211BBE0 r3=5 r4=70EFF000
PR r3
D 70EFF000 4
END

CASE sub_8246A1D8_heap_node_walked
W 82917E9C 70000000
W 70000000 82917E9C000000008213C3A0
CALL 8246A1D8 r3=1
PR r3
PCR 6
D 70000000 C
D 82917E9C 8
END

