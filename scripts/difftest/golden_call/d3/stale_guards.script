CASE sub_8211BBE0_fire_lowptr
W 70000000 AAAAAAAA
CALL 8211BBE0 r3=5 r4=70000000
PR r3
PR r10
PR r11
D 70000000 4
END

CASE sub_8211BBE0_normal
CALL 8211BBE0 r3=5 r4=829AC170
PR r3
PR r10
PR r11
D 829AC170 4
END

CASE sub_8246A1D8_fire_node_below_0x80000000
W 82917E9C 70000000
CALL 8246A1D8 r3=1
PR r3
PCR 6
D 82917E9C 8
END

CASE sub_8246A1D8_fire_over_256_callbacks
W 829AAEB4 829AAEB4
W 829AAEBC 8213C3A0
CALL 8246A1D8 r3=1
PR r3
PCR 6
D 829AAEB4 C
END

CASE sub_8246A1D8_normal
W 829AAEBC 8213C3A0
CALL 8246A1D8 r3=1
PR r3
