# iter-463 runtime shader translation: generate the XenosRecomp embed source.
#
#   cmake -DXR_DIR=<clone> -DOUT=<file.cpp> -P cmake/xenos_embed.cmake
#
# Writes one C++ file holding
#   - the exact bytes of <clone>/XenosRecomp/shader_common.h (CRLF on disk). The offline tool
#     reads that file and prepends it to every generated HLSL; the runtime translator must use
#     the same bytes or its DXIL differs from the offline cache;
#   - kTranslatorSourceId: SHA-256 over every source that decides what is translated and
#     admitted: the clone's recompiler + shader_common.h, the clone's dxc_compiler.cpp and main.cpp
#     (their DXC arguments and per-container flow are mirrored by hand in shader_xlat_core.cpp),
#     and our gfx/shader_xlat_core, gfx/xenos_bridge and gfx/shader_mkey.hpp (the proof, masks,
#     splice, preflight, DXC arguments, fetch walk). It keys the runtime disk cache: a change to
#     any of them starts a new directory instead of re-admitting DXIL made under the old rules
#     (persisted entries are not re-proved at boot). kRulesVersion in shader_runtime_xlat.cpp
#     stays as an extra salt.
# Used by cmake/xenos_xlat.cmake at configure time and by tools/difftest/shader_xlat_test_run.py,
# so the game and the standalone test embed byte-identical data. The file is rewritten only when
# its content changes.
if(NOT XR_DIR OR NOT OUT)
  message(FATAL_ERROR "xenos_embed.cmake: pass -DXR_DIR=<XenosRecomp clone> -DOUT=<output .cpp>")
endif()
set(_src "${XR_DIR}/XenosRecomp")
get_filename_component(_repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_ids "")
# Keep this list in sync with the CMAKE_CONFIGURE_DEPENDS lists in cmake/xenos_xlat.cmake.
foreach(_f constant_table.h pch.h shader.h shader_code.h shader_common.h shader_recompiler.cpp
           shader_recompiler.h dxc_compiler.cpp dxc_compiler.h main.cpp)
  if(NOT EXISTS "${_src}/${_f}")
    message(FATAL_ERROR "xenos_embed.cmake: missing ${_src}/${_f}")
  endif()
  file(SHA256 "${_src}/${_f}" _h)
  string(APPEND _ids "${_f}=${_h};")
endforeach()
foreach(_f gfx/shader_xlat_core.cpp gfx/shader_xlat_core.hpp gfx/xenos_bridge.cpp gfx/xenos_bridge.hpp
           gfx/shader_mkey.hpp)
  if(NOT EXISTS "${_repo}/${_f}")
    message(FATAL_ERROR "xenos_embed.cmake: missing ${_repo}/${_f}")
  endif()
  # Line endings do not change the translator: hash the text with CR removed, so a CRLF
  # checkout (core.autocrlf) gets the same id as an LF one.
  file(READ "${_repo}/${_f}" _t)
  string(REPLACE "\r" "" _t "${_t}")
  string(SHA256 _h "${_t}")
  string(APPEND _ids "${_f}=${_h};")
endforeach()
string(SHA256 _id "${_ids}")
file(READ "${_src}/shader_common.h" _hex HEX)
string(LENGTH "${_hex}" _hexlen)
math(EXPR _n "${_hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
# 64 bytes (320 characters of "0xNN,") per line keeps the file diff-able.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){64})" "\\1\n  " _bytes "${_bytes}")
set(_content "// GENERATED by cmake/xenos_embed.cmake from ${_src} - do not edit.
#include <cstddef>
namespace sr { namespace gfx { namespace xenos {
extern const unsigned char kShaderCommonH[];
extern const size_t kShaderCommonHSize;
extern const char kTranslatorSourceId[];
const unsigned char kShaderCommonH[] = {
  ${_bytes}
};
const size_t kShaderCommonHSize = ${_n};
const char kTranslatorSourceId[] = \"${_id}\";
}}}
")
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUT}" "${_content}")
endif()
