# iter-465 window: writes sr_version.h (SR_PORT_GIT_HASH = the short commit of the source tree)
# for the window title. Run every build by the sr_version_header target; file(CONFIGURE) only
# rewrites the header when the hash changed, so an unchanged tree recompiles nothing.
# Usage: cmake -DSRC=<source dir> -DOUT=<header path> -P gen_version.cmake
execute_process(COMMAND git rev-parse --short=8 HEAD
                WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE SR_HASH
                OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET
                RESULT_VARIABLE SR_HASH_RC)
if(NOT SR_HASH_RC EQUAL 0 OR SR_HASH STREQUAL "")
  set(SR_HASH "unknown")
endif()
file(CONFIGURE OUTPUT "${OUT}"
     CONTENT "#pragma once\n// Generated by cmake/gen_version.cmake - do not edit.\n#define SR_PORT_GIT_HASH \"@SR_HASH@\"\n"
     @ONLY)
