From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: loliver1823 <151630620+loliver1823@users.noreply.github.com>
Date: Sat, 10 Oct 2026 00:00:00 +1100
Subject: [PATCH] raw guest-memory addresses go through PPC_GUEST_OFFSET

lwarx / ldarx / stwcx. / stdcx., lvx / lvlx / lvrx / stvx (and the 128 forms), dcbz / dcbzl
and the setjmp / longjmp calls address guest memory as `base + X` directly instead of through
the PPC_LOAD / PPC_STORE macros. Emit `base + PPC_GUEST_OFFSET(X)` (ppc_context.h; the host's
guest-address alias) for each, exactly the text tools/regen/assemble.py wrapped them in as a
pass over the output until iter-467.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/XenonRecomp/recompiler.cpp b/XenonRecomp/recompiler.cpp
index b28a628..a8928e1 100644
--- a/XenonRecomp/recompiler.cpp
+++ b/XenonRecomp/recompiler.cpp
@@ -464,12 +464,12 @@ bool Recompiler::Recompile(
         {
             if (address == config.longJmpAddress)
             {
-                println("\tlongjmp(*reinterpret_cast<jmp_buf*>(base + {}.u32), {}.s32);", r(3), r(4));
+                println("\tlongjmp(*reinterpret_cast<jmp_buf*>(base + PPC_GUEST_OFFSET({}.u32)), {}.s32);", r(3), r(4));
             }
             else if (address == config.setJmpAddress)
             {
                 println("\t{} = ctx;", env());
-                println("\t{}.s64 = setjmp(*reinterpret_cast<jmp_buf*>(base + {}.u32));", temp(), r(3));
+                println("\t{}.s64 = setjmp(*reinterpret_cast<jmp_buf*>(base + PPC_GUEST_OFFSET({}.u32)));", temp(), r(3));
                 println("\tif ({}.s64 != 0) ctx = {};", temp(), env());
                 println("\t{} = {};", r(3), temp());
             }
@@ -950,14 +950,14 @@ bool Recompiler::Recompile(
         break;
 
     case PPC_INST_DCBZ:
-        print("\tmemset(base + ((");
+        print("\tmemset(base + PPC_GUEST_OFFSET((");
         if (insn.operands[0] != 0)
             print("{}.u32 + ", r(insn.operands[0]));
         println("{}.u32) & ~31), 0, 32);", r(insn.operands[1]));
         break;
 
     case PPC_INST_DCBZL:
-        print("\tmemset(base + ((");
+        print("\tmemset(base + PPC_GUEST_OFFSET((");
         if (insn.operands[0] != 0)
             print("{}.u32 + ", r(insn.operands[0]));
         println("{}.u32) & ~127), 0, 128);", r(insn.operands[1]));
@@ -1180,10 +1180,10 @@ bool Recompiler::Recompile(
         break;
 
     case PPC_INST_LDARX:
-        print("\t{}.u64 = *(uint64_t*)(base + ", reserved());
+        print("\t{}.u64 = *(uint64_t*)(base + PPC_GUEST_OFFSET(", reserved());
         if (insn.operands[1] != 0)
             print("{}.u32 + ", r(insn.operands[1]));
-        println("{}.u32);", r(insn.operands[2]));
+        println("{}.u32));", r(insn.operands[2]));
         println("\t{}.u64 = __builtin_bswap64({}.u64);", r(insn.operands[0]), reserved());
         break;
 
@@ -1276,7 +1276,7 @@ bool Recompiler::Recompile(
     case PPC_INST_LVX128:
         // NOTE: for endian swapping, we reverse the whole vector instead of individual elements.
         // this is accounted for in every instruction (eg. dp3 sums yzw instead of xyz)
-        print("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_shuffle_epi8(simde_mm_load_si128((simde__m128i*)(base + ((", v(insn.operands[0]));
+        print("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_shuffle_epi8(simde_mm_load_si128((simde__m128i*)(base + PPC_GUEST_OFFSET((", v(insn.operands[0]));
         if (insn.operands[1] != 0)
             print("{}.u32 + ", r(insn.operands[1]));
         println("{}.u32) & ~0xF))), simde_mm_load_si128((simde__m128i*)VectorMaskL)));", r(insn.operands[2]));
@@ -1288,7 +1288,7 @@ bool Recompiler::Recompile(
         if (insn.operands[1] != 0)
             print("{}.u32 + ", r(insn.operands[1]));
         println("{}.u32;", r(insn.operands[2]));
-        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_shuffle_epi8(simde_mm_load_si128((simde__m128i*)(base + ({}.u32 & ~0xF))), simde_mm_load_si128((simde__m128i*)&VectorMaskL[({}.u32 & 0xF) * 16])));", v(insn.operands[0]), temp(), temp());
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_shuffle_epi8(simde_mm_load_si128((simde__m128i*)(base + PPC_GUEST_OFFSET({}.u32 & ~0xF))), simde_mm_load_si128((simde__m128i*)&VectorMaskL[({}.u32 & 0xF) * 16])));", v(insn.operands[0]), temp(), temp());
         break;
 
     case PPC_INST_LVRX:
@@ -1297,7 +1297,7 @@ bool Recompiler::Recompile(
         if (insn.operands[1] != 0)
             print("{}.u32 + ", r(insn.operands[1]));
         println("{}.u32;", r(insn.operands[2]));
-        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, {}.u32 & 0xF ? simde_mm_shuffle_epi8(simde_mm_load_si128((simde__m128i*)(base + ({}.u32 & ~0xF))), simde_mm_load_si128((simde__m128i*)&VectorMaskR[({}.u32 & 0xF) * 16])) : simde_mm_setzero_si128());", v(insn.operands[0]), temp(), temp(), temp());
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, {}.u32 & 0xF ? simde_mm_shuffle_epi8(simde_mm_load_si128((simde__m128i*)(base + PPC_GUEST_OFFSET({}.u32 & ~0xF))), simde_mm_load_si128((simde__m128i*)&VectorMaskR[({}.u32 & 0xF) * 16])) : simde_mm_setzero_si128());", v(insn.operands[0]), temp(), temp(), temp());
         break;
 
     case PPC_INST_LVSL:
@@ -1324,10 +1324,10 @@ bool Recompiler::Recompile(
         break;
 
     case PPC_INST_LWARX:
-        print("\t{}.u32 = *(uint32_t*)(base + ", reserved());
+        print("\t{}.u32 = *(uint32_t*)(base + PPC_GUEST_OFFSET(", reserved());
         if (insn.operands[1] != 0)
             print("{}.u32 + ", r(insn.operands[1]));
-        println("{}.u32);", r(insn.operands[2]));
+        println("{}.u32));", r(insn.operands[2]));
         println("\t{}.u64 = __builtin_bswap32({}.u32);", r(insn.operands[0]), reserved());
         break;
 
@@ -1652,10 +1652,10 @@ bool Recompiler::Recompile(
     case PPC_INST_STDCX:
         println("\t{}.lt = 0;", cr(0));
         println("\t{}.gt = 0;", cr(0));
-        print("\t{}.eq = __sync_bool_compare_and_swap(reinterpret_cast<uint64_t*>(base + ", cr(0));
+        print("\t{}.eq = __sync_bool_compare_and_swap(reinterpret_cast<uint64_t*>(base + PPC_GUEST_OFFSET(", cr(0));
         if (insn.operands[1] != 0)
             print("{}.u32 + ", r(insn.operands[1]));
-        println("{}.u32), {}.s64, __builtin_bswap64({}.s64));", r(insn.operands[2]), reserved(), r(insn.operands[0]));
+        println("{}.u32)), {}.s64, __builtin_bswap64({}.s64));", r(insn.operands[2]), reserved(), r(insn.operands[0]));
         println("\t{}.so = {}.so;", cr(0), xer());
         break;
 
@@ -1792,7 +1792,7 @@ bool Recompiler::Recompile(
 
     case PPC_INST_STVX:
     case PPC_INST_STVX128:
-        print("\tsimde_mm_store_si128((simde__m128i*)(base + ((");
+        print("\tsimde_mm_store_si128((simde__m128i*)(base + PPC_GUEST_OFFSET((");
         if (insn.operands[1] != 0)
             print("{}.u32 + ", r(insn.operands[1]));
         println("{}.u32) & ~0xF)), simde_mm_shuffle_epi8(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*)VectorMaskL)));", r(insn.operands[2]), v(insn.operands[0]));
@@ -1815,10 +1815,10 @@ bool Recompiler::Recompile(
     case PPC_INST_STWCX:
         println("\t{}.lt = 0;", cr(0));
         println("\t{}.gt = 0;", cr(0));
-        print("\t{}.eq = __sync_bool_compare_and_swap(reinterpret_cast<uint32_t*>(base + ", cr(0));
+        print("\t{}.eq = __sync_bool_compare_and_swap(reinterpret_cast<uint32_t*>(base + PPC_GUEST_OFFSET(", cr(0));
         if (insn.operands[1] != 0)
             print("{}.u32 + ", r(insn.operands[1]));
-        println("{}.u32), {}.s32, __builtin_bswap32({}.s32));", r(insn.operands[2]), reserved(), r(insn.operands[0]));
+        println("{}.u32)), {}.s32, __builtin_bswap32({}.s32));", r(insn.operands[2]), reserved(), r(insn.operands[0]));
         println("\t{}.so = {}.so;", cr(0), xer());
         break;
 
