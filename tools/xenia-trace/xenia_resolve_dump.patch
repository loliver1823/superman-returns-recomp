+    dump_tex_desc = texture_resource->GetDesc();
+    // Guard: only dump COMPRESSED (BC1-BC7) content textures of reasonable size.
+    // This skips the flood of RAW render-targets/FMV buffers (which would stall
+    // the GPU thousands of times and never reach the menu), capturing only real
