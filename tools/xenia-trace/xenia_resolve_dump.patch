+bool D3D12RenderTargetCache::CompleteEdramDownload(std::vector<uint8_t>& out) {
+  if (!edram_snapshot_download_buffer_) {
+    return false;
+  }
+  void* download_mapping;
+  bool ok = false;
+  if (SUCCEEDED(edram_snapshot_download_buffer_->Map(0, nullptr,
+                                                     &download_mapping))) {
+    const uint8_t* bytes = reinterpret_cast<const uint8_t*>(download_mapping);
+    out.assign(bytes, bytes + xenos::kEdramSizeBytes);
+    D3D12_RANGE download_write_range = {};
+    edram_snapshot_download_buffer_->Unmap(0, &download_write_range);
+    ok = true;
+  }
+  return ok;
+}
