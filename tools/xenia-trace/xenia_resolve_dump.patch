+                                  &dump_row_bytes, &dump_total);
+    dump_rb = command_processor_.DumpRequestReadbackBuffer(uint32_t(dump_total));
+    if (dump_rb != nullptr) {
+      // texture_resource was left in COPY_DEST by the copy loop; move it to
+      // COPY_SOURCE so we can read it back. We leave it recorded as COPY_SOURCE
