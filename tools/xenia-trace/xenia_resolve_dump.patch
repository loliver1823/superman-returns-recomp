+// Writes the UNTILED host (subresource 0) pixels mapped from a readback buffer
+// out as a .DDS. The readback buffer's rows are padded to RowPitch
+// (D3D12_TEXTURE_DATA_PITCH_ALIGNMENT); this strips that padding so the DDS
+// body is tightly packed (the form the recomp consumes).
+static void DumpHostTextureDDS(DXGI_FORMAT fmt, uint32_t width, uint32_t height,
+                               const D3D12_PLACED_SUBRESOURCE_FOOTPRINT& fp,
+                               uint32_t rows, uint32_t tight_row_bytes,
+                               const void* mapped, uint32_t base_page,
+                               xenos::TextureFormat guest_format) {
+  struct {
+    uint32_t size;
+    uint32_t flags;
+    uint32_t height;
+    uint32_t width;
+    uint32_t pitch_or_linear_size;
+    uint32_t depth;
+    uint32_t mip_levels;
+    uint32_t reserved1[11];
+    struct {
+      uint32_t size;
+      uint32_t flags;
+      uint32_t fourcc;  // little-endian fourcc as stored in a DDS file
+      uint32_t rgb_bit_count;
+      uint32_t r_bit_mask;
+      uint32_t g_bit_mask;
+      uint32_t b_bit_mask;
+      uint32_t a_bit_mask;
+    } pixel_format;
+    uint32_t caps[4];
+    uint32_t reserved2;
+  } dds_header;
+
+  std::memset(&dds_header, 0, sizeof(dds_header));
+  dds_header.size = sizeof(dds_header);
+  // DDSD_CAPS|HEIGHT|WIDTH|PIXELFORMAT|MIPMAPCOUNT
+  dds_header.flags = 0x1u | 0x2u | 0x4u | 0x1000u | 0x20000u;
+  dds_header.height = height;
+  dds_header.width = width;
+  dds_header.depth = 1;
+  dds_header.mip_levels = 1;
+  dds_header.pixel_format.size = sizeof(dds_header.pixel_format);
+
+  auto fourcc = [](char a, char b, char c, char d) -> uint32_t {
+    return uint32_t(uint8_t(a)) | (uint32_t(uint8_t(b)) << 8) |
+           (uint32_t(uint8_t(c)) << 16) | (uint32_t(uint8_t(d)) << 24);
+  };
+  bool is_bc = false;
+  const char* fmt_name = "RAW";
+  switch (fmt) {
+    case DXGI_FORMAT_BC1_UNORM:
+    case DXGI_FORMAT_BC1_UNORM_SRGB:
+      dds_header.pixel_format.flags = 0x4u;  // DDPF_FOURCC
+      dds_header.pixel_format.fourcc = fourcc('D', 'X', 'T', '1');
+      is_bc = true;
+      fmt_name = "BC1";
+      break;
+    case DXGI_FORMAT_BC2_UNORM:
+    case DXGI_FORMAT_BC2_UNORM_SRGB:
+      dds_header.pixel_format.flags = 0x4u;
+      dds_header.pixel_format.fourcc = fourcc('D', 'X', 'T', '3');
+      is_bc = true;
+      fmt_name = "BC2";
+      break;
+    case DXGI_FORMAT_BC3_UNORM:
+    case DXGI_FORMAT_BC3_UNORM_SRGB:
+      dds_header.pixel_format.flags = 0x4u;
+      dds_header.pixel_format.fourcc = fourcc('D', 'X', 'T', '5');
+      is_bc = true;
+      fmt_name = "BC3";
+      break;
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+      // DDPF_RGB|DDPF_ALPHAPIXELS, RGBA8 (R in low byte for this fourcc-less).
+      dds_header.pixel_format.flags = 0x1u | 0x40u;
+      dds_header.pixel_format.rgb_bit_count = 32;
+      dds_header.pixel_format.r_bit_mask = 0x000000FFu;
+      dds_header.pixel_format.g_bit_mask = 0x0000FF00u;
+      dds_header.pixel_format.b_bit_mask = 0x00FF0000u;
+      dds_header.pixel_format.a_bit_mask = 0xFF000000u;
+      fmt_name = "RGBA8";
+      break;
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+      dds_header.pixel_format.flags = 0x1u | 0x40u;
+      dds_header.pixel_format.rgb_bit_count = 32;
+      dds_header.pixel_format.r_bit_mask = 0x00FF0000u;
+      dds_header.pixel_format.g_bit_mask = 0x0000FF00u;
+      dds_header.pixel_format.b_bit_mask = 0x000000FFu;
+      dds_header.pixel_format.a_bit_mask = 0xFF000000u;
+      fmt_name = "BGRA8";
+      break;
+    default:
+      XELOGW("texture_dump: unhandled host DXGI format {}, dumping raw bytes",
+             uint32_t(fmt));
+      break;
+  }
+  if (is_bc) {
+    dds_header.flags |= 0x80000u;  // DDSD_LINEARSIZE
+    dds_header.pitch_or_linear_size = tight_row_bytes * rows;
+  } else {
+    dds_header.flags |= 0x8u;  // DDSD_PITCH
+    dds_header.pitch_or_linear_size = tight_row_bytes;
+  }
+  dds_header.caps[0] = 0x1000u;  // DDSCAPS_TEXTURE
+
+  std::filesystem::path path = "texture_dumps";
+  std::error_code ec;
+  std::filesystem::create_directories(path, ec);
+  static int dump_counter = 0;
+  char name[128];
+  std::snprintf(name, sizeof(name), "host_%05d_%08X_%ux%u_%s.dds",
+                dump_counter++, base_page << 12, width, height, fmt_name);
+  path /= name;
+
+  FILE* handle = xe::filesystem::OpenFile(path, "wb");
+  if (handle) {
+    const char signature[4] = {'D', 'D', 'S', ' '};
+    fwrite(signature, sizeof(signature), 1, handle);
+    fwrite(&dds_header, sizeof(dds_header), 1, handle);
+    const uint8_t* src = reinterpret_cast<const uint8_t*>(mapped);
+    for (uint32_t r = 0; r < rows; ++r) {
+      fwrite(src + uint64_t(r) * fp.Footprint.RowPitch, tight_row_bytes, 1,
+             handle);
+    }
+    fclose(handle);
+    XELOGI("texture_dump: wrote {}", xe::path_to_utf8(path));
+  }
+}
