@@ -74,6 +75,24 @@ using namespace xe::literals;
 
 static constexpr size_t kMaxCodeSize = 1_MiB;
 
+// L9-A golden-oracle trace trampoline.
+// Called from every JIT'd guest-function PROLOG via CallNative (the guest->host
+// thunk), so it runs on EVERY guest function entry, including guest->guest bl
+// calls that never re-enter through GuestFunction::Call. The thunk passes the
+// PPCContext* as arg0 (rcx) and the guest function address as arg1 (rdx).
+// No-op (single env-gated branch) unless XENIA_GUEST_TRACE=1. The guest_pc is a
+// compile-time constant baked into the prolog, so it is always correct; the key
+// PPC regs are read from the (host-native / already byte-swapped) context, the
+// SAME values the GuestFunction::Call hook samples, so the on-disk format and
+// register semantics are unchanged.
+static uint64_t XeTraceJitProlog(void* raw_context, uint64_t guest_pc) {
+  auto* ctx = reinterpret_cast<ppc::PPCContext*>(raw_context);
+  xe::trace::GuestTracer::Get().EmitFuncEntry(
+      static_cast<uint32_t>(guest_pc), static_cast<uint32_t>(ctx->lr),
+      ctx->r[3], ctx->r[1], ctx->thread_id);
+  return 0;
+}
