+  // EMISSION itself on the same env var (checked once at JIT time) so that when
+  // tracing is off, JIT'd code is byte-for-byte identical to stock Xenia and
+  // pays zero per-call overhead.
+  if (xe::trace::GuestTracer::Get().enabled()) {
+    CallNative(&XeTraceJitProlog,
+               static_cast<uint64_t>(current_guest_function_));
+  }
