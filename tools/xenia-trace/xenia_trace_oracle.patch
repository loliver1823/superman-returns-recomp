 static constexpr size_t kMaxCodeSize = 1_MiB;
 
+// superman-recomp L9-A oracle trace trampolines (tools/xenia-trace/README.md).
+// Reached through CallNative -> guest_to_host_thunk, which saves/restores the
+// volatile registers and MXCSR and passes the PPCContext* first. Only emitted
+// when XENIA_GUEST_TRACE=1 (and the VA filters select the function), so with
+// tracing off the JIT output is stock.
+//
+// Prolog hook: guest_pc is the JIT-time constant function address.
+static uint64_t XeTraceJitProlog(void* raw_context, uint64_t guest_pc) {
+  auto* ctx = reinterpret_cast<ppc::PPCContext*>(raw_context);
+  xe::trace::GuestTracer::Get().EmitFuncEntry(
+      static_cast<uint32_t>(guest_pc), static_cast<uint32_t>(ctx->lr),
+      ctx->r[3], ctx->r[1], ctx->thread_id);
+  return 0;
+}
+// Call-site hook: the target was parked in ctx->scratch by the emitted code;
+// ctx->lr already holds the call-site return address (the frontend's StoreLR
+// precedes the CALL_INDIRECT, and calls are volatile so the store is not
+// eliminated). arg0 = the calling function's entry VA (JIT-time constant).
+static uint64_t XeTraceIndirectCall(void* raw_context, uint64_t fn_va) {
+  auto* ctx = reinterpret_cast<ppc::PPCContext*>(raw_context);
+  xe::trace::GuestTracer::Get().EmitIndirectCall(
+      static_cast<uint32_t>(fn_va), static_cast<uint32_t>(ctx->scratch),
+      static_cast<uint32_t>(ctx->lr), ctx->r[3], ctx->r[1], ctx->thread_id);
+  return 0;
+}
+
 // static const size_t kStashOffsetHigh = 32 + 32;
 
