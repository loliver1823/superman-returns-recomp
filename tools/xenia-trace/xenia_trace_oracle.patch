+  // superman-recomp L9-A oracle: per-function-entry trace, emitted only for the
+  // functions XENIA_GUEST_TRACE_VAS selects (all when unset). Fires on guest->guest
+  // bl calls too, unlike the GuestFunction::Call hook.
+  if (xe::trace::GuestTracer::Get().WantProlog(current_guest_function_)) {
+    CallNative(&XeTraceJitProlog,
+               static_cast<uint64_t>(current_guest_function_));
+  }
+
   // Load membase.
   /*
   * chrispy: removed this, as long as we load it in HostToGuestThunk we can
@@ -748,6 +783,16 @@ void X64Emitter::CallIndirect(const hir::Instr* instr,
     je(epilog_label(), CodeGenerator::T_NEAR);
   }
 
+  // superman-recomp L9-A oracle: indirect-call hook (XENIA_GUEST_TRACE_ICALL_FUNCS
+  // / _ICALL_BAD). Park the target in ctx->scratch (CallNative clobbers rcx/rdx/rax
+  // before the thunk saves registers), record, then reload it into `reg`.
+  if (xe::trace::GuestTracer::Get().WantIcall(current_guest_function_)) {
+    mov(qword[GetContextReg() + offsetof(ppc::PPCContext, scratch)], reg);
+    CallNative(&XeTraceIndirectCall,
+               static_cast<uint64_t>(current_guest_function_));
+    mov(reg, qword[GetContextReg() + offsetof(ppc::PPCContext, scratch)]);
+  }
+
   // Load the pointer to the indirection table maintained in X64CodeCache.
   // The target dword will either contain the address of the generated code
   // or a thunk to ResolveAddress.
