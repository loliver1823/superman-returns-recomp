+// iter-456p Slice C: log ONLY the slots the active shaders actually sample.
+void TracePlayer::LogSampledTextures(uint32_t draw_ordinal) {
+  auto command_processor = graphics_system_->command_processor();
+  auto* regs = graphics_system_->register_file();
+  if (!regs) return;
+
+  auto dump_stage = [&](const char* stage, Shader* shader) {
+    if (!shader) return;
+    for (const auto& b : shader->texture_bindings()) {
+      const uint32_t slot = b.fetch_constant;
+      if (slot >= 32) continue;
+      // Fetch constants live at XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0, six
+      // dwords per texture slot.
+      const uint32_t base =
+          XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + slot * 6;
+      uint32_t f[6];
+      for (uint32_t i = 0; i < 6; i++) f[i] = regs->values[base + i];
+      XELOGI(
+          "[XE_SAMPLED] draw={} stage={} shaderHash={:016X} slot={} "
+          "raw={:08X},{:08X},{:08X},{:08X},{:08X},{:08X}",
+          draw_ordinal, stage, shader->ucode_data_hash(), slot, f[0], f[1],
+          f[2], f[3], f[4], f[5]);
+    }
+  };
+  dump_stage("VS", command_processor->active_vertex_shader());
+  dump_stage("PS", command_processor->active_pixel_shader());
+}
