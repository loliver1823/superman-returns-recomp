+void CommandProcessor::DrainZPDReportsForTrace() {
+  // Close the open interval as a frame end does, then retire the queue in
+  // order: a report still measuring waits for its last segment's submission.
+  EndZPDFrame();
+  PumpQueryResolves();
+  PumpPendingRetire();
+  size_t guard = 0;
+  while (!zpd_reports_.empty() && guard++ < (size_t(1) << 20)) {
+    ZPDReport& front = zpd_reports_.front();
+    if (front.pending_segments &&
+        (!front.last_segment_end_submission ||
+         !AwaitQueryResolve(front.handle, front.last_segment_end_submission))) {
+      break;
+    }
+    const size_t before = zpd_reports_.size();
+    PumpPendingRetire();
+    if (zpd_reports_.size() == before) {
+      break;
+    }
+  }
+  XELOGI("SR_ZPD_DRAIN left={} mode={}", zpd_reports_.size(),
+         zpd_mode_ == ZPDMode::kStrict ? "strict" : "other");
+}
