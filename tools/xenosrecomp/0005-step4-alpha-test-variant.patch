diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index 16d6e5c..4aaf53c 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -1530,6 +1530,11 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
     }
 
     out += "\tDEFINE_SHARED_CONSTANTS();\n";
+    // superman (step 4, 0005): the alpha-test variant's test word (shader_recompiler.h alphaTestMode).
+    alphaTestEmitted = alphaTestMode && isPixelShader &&
+        (reinterpret_cast<const PixelShader*>(shaderData + shaderContainer->shaderOffset)->outputs & PIXEL_SHADER_OUTPUT_COLOR0) != 0;
+    if (alphaTestEmitted)
+        out += "\tuint g_AlphaTest : packoffset(c17.y);\n";
     out += "};\n\n";
 
     out += "#endif\n";
@@ -2244,6 +2249,32 @@ float4 XeVfLoad(uint slot, uint addr, int offsetDwords, uint fmt, bool isSigned,
                     indent();
                     out += "}";
 
+                    if (alphaTestEmitted)
+                    {
+                        // superman (step 4, 0005): the Xenos alpha test, as Xenia's CompletePixelShader (shader_recompiler.h
+                        // alphaTestMode): g_AlphaTest = 8 | RB_COLORCONTROL.alpha_func (0 = no test), ALWAYS skips,
+                        // NOT_EQUAL is "not equal" (true for NaN), the others the LESS / EQUAL / GREATER mask.
+                        out += '\n';
+                        indent();
+                        out += "[branch] if ((g_AlphaTest & 8u) != 0u && (g_AlphaTest & 7u) != 7u)\n";
+                        indent();
+                        out += "{\n";
+                        indent();
+                        out += "\tuint xeAlphaMask = g_AlphaTest & 7u;\n";
+                        indent();
+                        out += "\tbool xeAlphaPass = xeAlphaMask == 5u ? (oC0.w != g_AlphaThreshold) :\n";
+                        indent();
+                        out += "\t\t(((xeAlphaMask & 1u) != 0u && oC0.w < g_AlphaThreshold) ||\n";
+                        indent();
+                        out += "\t\t ((xeAlphaMask & 2u) != 0u && oC0.w == g_AlphaThreshold) ||\n";
+                        indent();
+                        out += "\t\t ((xeAlphaMask & 4u) != 0u && oC0.w > g_AlphaThreshold));\n";
+                        indent();
+                        out += "\tif (!xeAlphaPass) discard;\n";
+                        indent();
+                        out += "}\n";
+                    }
+
                 #ifdef UNLEASHED_RECOMP
                     specConstantsMask |= SPEC_CONSTANT_ALPHA_TO_COVERAGE;
 
diff --git a/XenosRecomp/shader_recompiler.h b/XenosRecomp/shader_recompiler.h
