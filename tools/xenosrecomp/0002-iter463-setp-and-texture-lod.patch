+// superman (iter-463): explicit-LOD (SampleLevel) and biased (SampleBias)
+// forms of tfetch2D / tfetch3D / tfetchCube for setTexLOD, UseRegisterLOD,
+// UseComputedLOD=false and LOD-bias fetches (Xenia
+// dxbc_shader_translator_fetch.cc: sample_l for an explicit LOD, sample_d
+// with exp2(bias)-scaled gradients for a computed one). Resource selection
+// is the same as in the implicit-LOD forms.
+#define XE_TFETCH_LOD_VARIANTS(SUFFIX, SAMPLE, LODARG) \
+float4 tfetch2D##SUFFIX(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset, float LODARG) \
+{ \
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex]; \
+    return texture.SAMPLE(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord + offset / getTexture2DDimensions(texture), LODARG); \
+} \
+float4 tfetch3D##SUFFIX(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float3 texCoord, float3 offset, float LODARG) \
+{ \
+    if (resourceDescriptorIndex & 0x80000000u) \
+    { \
+        const uint index = resourceDescriptorIndex & 0x1FFFFFFFu; \
+        if (resourceDescriptorIndex & 0x20000000u) \
+        { \
+            Texture3D<float4> volume = g_Texture3DBandDescriptorHeap[index]; \
+            uint3 vd; \
+            volume.GetDimensions(vd.x, vd.y, vd.z); \
+            return volume.SAMPLE(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord + offset / float3(vd), LODARG); \
+        } \
+        if (resourceDescriptorIndex & 0x40000000u) \
+        { \
+            Texture2DArray<float4> array = g_Texture2DArrayDescriptorHeap[index]; \
+            uint3 d; \
+            array.GetDimensions(d.x, d.y, d.z); \
+            return array.SAMPLE(g_SamplerDescriptorHeap[samplerDescriptorIndex], \
+                                float3(texCoord.xy + offset.xy / float2(d.xy), floor(texCoord.z * d.z + offset.z)), LODARG); \
+        } \
+        Texture2D<float4> texture2D = g_Texture2DDescriptorHeap[index]; \
+        return texture2D.SAMPLE(g_SamplerDescriptorHeap[samplerDescriptorIndex], \
+                                texCoord.xy + offset.xy / getTexture2DDimensions(texture2D), LODARG); \
+    } \
+    Texture3D<float4> texture = g_Texture3DDescriptorHeap[resourceDescriptorIndex]; \
+    uint3 dimensions; \
+    texture.GetDimensions(dimensions.x, dimensions.y, dimensions.z); \
+    return texture.SAMPLE(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord + offset / float3(dimensions), LODARG); \
+} \
+float4 tfetchCube##SUFFIX(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float3 texCoord, inout CubeMapData cubeMapData, float LODARG) \
+{ \
+    if (resourceDescriptorIndex & 0x80000000u) \
+        return g_TextureCubeBandDescriptorHeap[resourceDescriptorIndex & 0x1FFFFFFFu].SAMPLE( \
+            g_SamplerDescriptorHeap[samplerDescriptorIndex], cubeMapData.cubeMapDirections[texCoord.z], LODARG); \
+    return g_TextureCubeDescriptorHeap[resourceDescriptorIndex].SAMPLE(g_SamplerDescriptorHeap[samplerDescriptorIndex], \
+        cubeMapData.cubeMapDirections[texCoord.z], LODARG); \
+}
+
+XE_TFETCH_LOD_VARIANTS(Level, SampleLevel, lod)
+XE_TFETCH_LOD_VARIANTS(Bias, SampleBias, bias)
