{
  "name": "modlib-tour",
  "purpose": "iter-465 modlib: the mod library (docs/MODS.md 'The mod library') reached the player's way - title -> MAIN MENU -> MODS (row 4) - then a tour of every page with the harness keyboard AND the harness mouse feed, an F12 capture (SR_MOD_LIBRARY_SHOTS: the composited frame, overlay included) at each stop, VALUE checks of the saves (mods/mods.json via SR_MODS_ALLOW_WRITE), and a close that hands the menu back without leaking the B press. Content root: tools/modlib/make_test_mods.py into <croot>/mods, exe snapshot as <croot>/bin. Gates: SR_INSTANCE_ID=modlib,SR_PORT_FEATURES=1,SR_MODS=@player,SR_MODS_ALLOW_WRITE=1,SR_MOD_LIBRARY_SHOTS=<dir>,SR_WINDOW_SIZE=<w>x<h>. -TimeoutSeconds 900.",
  "gates": "SR_KB_PAD_OBS=1,SR_MOUSE_UI_LOG=1",
  "steps": [
    { "name": "feature-generated", "await": "\\[PORT\\] applied custom_frontend", "timeoutMs": 60000 },
    { "name": "fe-alive", "await": "\\[NAT_FE\\] #256 natural FE master tick", "timeoutMs": 240000 },
    { "name": "press-start", "key": "ENTER", "holdMs": 2000, "holdUntilConfirmed": true, "maxPulses": 4, "gapMs": 12000, "expect": "\\[APT_SCREEN\\] path='main'|\\[APT_LOADMOVIE\\].*\\(\"main\"\\)", "expectMs": 90000 },
    { "name": "title-ui-tail", "await": "\\[APT_REQ\\] #\\d+ path='\\.\\./common/ButtonHints/XBox360/HintB'", "timeoutMs": 180000 },
    { "name": "start-bootflow", "key": "ENTER", "holdMs": 2000, "holdUntilConfirmed": true, "maxPulses": 3, "gapMs": 10000, "expect": "\\[SR_FSCMD\\].*claim LoadCreate", "expectMs": 30000 },
    { "name": "menu-visible", "dwellMs": 5000 },
    { "name": "down-1", "key": "DOWN", "holdMs": 2000, "holdUntilConfirmed": true, "maxPulses": 2, "gapMs": 1500, "expect": "\\[SR_FSCMD\\].*SR_Log 'menu key=40'", "expectFresh": true, "expectMs": 10000, "dwellMs": 800 },
    { "name": "down-2", "key": "DOWN", "holdMs": 2000, "holdUntilConfirmed": true, "maxPulses": 2, "gapMs": 1500, "expect": "\\[SR_FSCMD\\].*SR_Log 'menu key=40'", "expectFresh": true, "expectMs": 10000, "dwellMs": 800 },
    { "name": "down-3", "key": "DOWN", "holdMs": 2000, "holdUntilConfirmed": true, "maxPulses": 2, "gapMs": 1500, "expect": "\\[SR_FSCMD\\].*SR_Log 'menu key=40'", "expectFresh": true, "expectMs": 10000, "dwellMs": 1200 },
    { "name": "open-mods", "purpose": "MAIN MENU > MODS opens the library overlay (the Apt menu closes back to its own row)", "key": "A", "holdMs": 250, "maxPulses": 3, "gapMs": 6000, "expect": "\\[MODLIB\\] shown \\(FE", "expectMs": 15000, "dwellMs": 3500 },

    { "name": "shot-library", "purpose": "LIBRARY: all mods, the first card focused", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectMs": 10000, "dwellMs": 500 },
    { "name": "grid-right", "key": "RIGHT", "holdMs": 120, "maxPulses": 1, "dwellMs": 500 },
    { "name": "grid-down", "key": "DOWN", "holdMs": 120, "maxPulses": 1, "dwellMs": 900 },
    { "name": "shot-grid-moved", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "mouse-hover", "purpose": "the mouse takes the focus: hover the second card of the first row", "mouse": "move 600,190; wait 400; move 640,200; wait 900", "dwellMs": 300 },
    { "name": "shot-hover", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "mouse-details", "purpose": "a click on a card opens its details", "mouse": "click 640,200; wait 2200" },
    { "name": "shot-details", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "details-next-image", "key": "RB", "holdMs": 120, "maxPulses": 1, "dwellMs": 1600 },
    { "name": "shot-details-image2", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "details-back", "key": "B", "holdMs": 150, "maxPulses": 1, "dwellMs": 800 },

    { "name": "grid-left", "key": "LEFT", "holdMs": 120, "maxPulses": 1, "dwellMs": 400 },
    { "name": "rail-left", "purpose": "LEFT from column 0: into the category rail", "key": "LEFT", "holdMs": 120, "maxPulses": 1, "dwellMs": 500 },
    { "name": "rail-characters", "key": "DOWN", "holdMs": 120, "maxPulses": 1, "dwellMs": 900 },
    { "name": "shot-characters", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "pack-open", "key": "A", "holdMs": 120, "maxPulses": 1, "dwellMs": 600 },
    { "name": "pack-details", "key": "A", "holdMs": 120, "maxPulses": 1, "dwellMs": 2200 },
    { "name": "suit-focus", "key": "DOWN", "holdMs": 120, "maxPulses": 1, "dwellMs": 300 },
    { "name": "suit-focus2", "key": "DOWN", "holdMs": 120, "maxPulses": 1, "dwellMs": 500 },
    { "name": "suit-toggle", "purpose": "untick the second suit: saved by its stable id (VALUE check in mods.json)", "key": "A", "holdMs": 120, "maxPulses": 1, "expect": "\\[MODLIB\\] suit suit_collection/recovery excluded -> saved", "expectMs": 6000, "dwellMs": 900 },
    { "name": "shot-suits", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "pack-back", "key": "B", "holdMs": 150, "maxPulses": 1, "dwellMs": 700 },

    { "name": "tab-order", "key": "RB", "holdMs": 150, "maxPulses": 1, "dwellMs": 1600 },
    { "name": "shot-order", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "order-toggle", "purpose": "A on the first row switches it off (VALUE check)", "key": "A", "holdMs": 120, "maxPulses": 1, "expect": "\\[MODLIB\\] disable \\w+ -> saved", "expectMs": 6000, "dwellMs": 600 },
    { "name": "order-down", "key": "DOWN", "holdMs": 120, "maxPulses": 1, "dwellMs": 400 },
    { "name": "order-grab", "key": "X", "holdMs": 120, "maxPulses": 1, "dwellMs": 400 },
    { "name": "order-move", "purpose": "the grabbed mod moves down twice (VALUE check: each step saved)", "key": "DOWN", "holdMs": 120, "maxPulses": 1, "expect": "\\[MODLIB\\] move \\w+ down -> saved", "expectMs": 6000, "dwellMs": 400 },
    { "name": "order-move2", "key": "DOWN", "holdMs": 120, "maxPulses": 1, "expect": "\\[MODLIB\\] move \\w+ down -> saved", "expectFresh": true, "expectMs": 6000, "dwellMs": 600 },
    { "name": "shot-grabbed", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "order-drop", "key": "A", "holdMs": 120, "maxPulses": 1, "dwellMs": 700 },
    { "name": "mouse-drag", "purpose": "drag the row in slot 5 up to slot 2 with the mouse (VALUE check: moves saved)", "mouse": "move 400,356; wait 500; drag 400,356 400,224; wait 1200", "expect": "\\[MODLIB\\] move \\w+ up -> saved", "expectFresh": true, "expectMs": 8000 },
    { "name": "shot-dragged", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },

    { "name": "tab-more", "key": "RB", "holdMs": 150, "maxPulses": 1, "dwellMs": 1500 },
    { "name": "shot-more", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "restart-ask", "purpose": "Y with changes pending opens the restart confirmation", "key": "Y", "holdMs": 150, "maxPulses": 1, "dwellMs": 1200 },
    { "name": "shot-restart", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "restart-not-now", "key": "B", "holdMs": 150, "maxPulses": 1, "dwellMs": 700 },
    { "name": "tab-back1", "key": "LB", "holdMs": 150, "maxPulses": 1, "dwellMs": 500 },
    { "name": "tab-library", "key": "LB", "holdMs": 150, "maxPulses": 1, "dwellMs": 1200 },
    { "name": "shot-library-after", "purpose": "the grid after the changes: NEEDS RESTART badges + the banner", "key": "F12", "holdMs": 150, "maxPulses": 1, "expect": "\\[MODLIB\\] shot", "expectFresh": true, "expectMs": 10000, "dwellMs": 400 },
    { "name": "close", "purpose": "B closes back to the MAIN MENU; the B never reaches the menu (it stays on MODS)", "key": "B", "holdMs": 300, "maxPulses": 1, "expect": "\\[MODLIB\\] hidden", "expectMs": 8000, "dwellMs": 4000 },
    { "name": "menu-still-there", "purpose": "a DOWN on the main menu after the close is the game's own (the input latch released)", "key": "DOWN", "holdMs": 2000, "holdUntilConfirmed": true, "maxPulses": 2, "gapMs": 1500, "expect": "\\[SR_FSCMD\\].*SR_Log 'menu key=40'", "expectFresh": true, "expectMs": 10000, "dwellMs": 1000 }
  ]
}
