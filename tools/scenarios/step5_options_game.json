      "key": "A",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 6000,
      "expect": "\\[GAME_OPTIONS\\] _global\\.SRPause\\.SR_OptionsClosed\\(1: VIEW PAD LAYOUT\\) called",
