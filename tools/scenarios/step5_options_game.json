{
  "name": "step5-options-game",
  "purpose": "Lane E L-b (RELEASE_PLAN step 5; STEP5_PLAN 10, owner q14d): ONE OPTIONS screen with the GAME tab first. Port features on, audio null, the harness keyboard (the OPTIONS overlay polls the harness channel itself). FRONT END: MAIN MENU > OPTIONS opens the OPTIONS overlay directly (no Apt SETTINGS panel), after the game's own getters reported its options (SR_GameOptionsLive 'FE ..'). GAME tab: INVERT LOOK previewed (the game's own setters through ApplyStore: 'apply why=3 ... match=true'), APPLY stores it, B closes back to the menu. NEW GAME re-applies the store (apply why=1 match=true). IN GAME (lane E L-c: OPTIONS is the pause menu's own row): pause > OPTIONS opens the same screen over the pause menu; the live report has invY=1 (the front end's change is the game's own state in game); CHEATS is listed in game (LB from GAME wraps to it) and its first row goes to the game, which refuses it before Warworld (the game's own rule); back on GAME, INVERT LOOK off is previewed and APPLIED through SRPause; B closes it (SR_OptionsClosed(0): the pause menu, OPTIONS focused). The write reached the game (the coordinator's check, no retail screen): RESUME into gameplay, pause, OPTIONS again - the game's own getters, read at the open, report invY=0; CONTROLS > VIEW PAD LAYOUT closes the screen and the pause menu's opener shows the game's own CONTROLLER OPTIONS (its pad diagram); its B returns to the pause menu (OPTIONS focused). Then QUIT GAME > QUIT TO TITLE, START, NEW GAME (the universal store re-applied: apply why=1 match=true), pause, OPTIONS: the getters report invY=0 again.",
  "gates": "SR_PORT_FEATURES=1,SR_MENU_CENSUS=1,SR_AUDIO_SINK=null,SR_KB_PAD_OBS=1,SR_PRESENT_DUMP=1,SR_PRESENT_DUMP_SPARSE_EVERY=20,SR_PRESENT_DUMP_SPARSE_CAP=1500",
  "steps": [
    {
      "name": "fe-alive",
      "await": "\\[NAT_FE\\] #1 natural FE master tick",
      "timeoutMs": 180000
    },
    {
      "name": "settle-title",
      "await": "\\[NAT_FE\\] #256 natural FE master tick",
      "timeoutMs": 180000
    },
    {
      "name": "press-start",
      "key": "ENTER",
      "holdMs": 2000,
      "holdUntilConfirmed": true,
      "maxPulses": 4,
      "gapMs": 12000,
      "expect": "\\[APT_SCREEN\\] path='main'|\\[APT_LOADMOVIE\\].*\\(\"main\"\\)",
      "expectMs": 90000
    },
    {
      "name": "title-ui-tail",
      "await": "\\[APT_REQ\\] #15 path='\\.\\./common/ButtonHints/XBox360/HintB'",
      "timeoutMs": 240000
    },
    {
      "name": "title-visible",
      "requireVisibleMs": 8000,
      "visibleTimeoutMs": 200000,
      "dwellMs": 6000
    },
    {
      "name": "start-bootflow",
      "key": "ENTER",
      "holdMs": 2000,
      "holdUntilConfirmed": true,
      "maxPulses": 3,
      "gapMs": 10000,
      "expect": "\\[SR_FSCMD\\].*claim LoadCreate",
      "expectMs": 30000
    },
    {
      "name": "menu-census",
      "purpose": "the MAIN MENU is up with its five rows (the census line gives counts, not labels - the Ally lb2 roll; that the third row is OPTIONS is proven by its own open below)",
      "expect": "\\[MENU_CENSUS\\] .*screen=ScrGenPop page='MAIN MENU' .* items=5 ",
      "expectSince": "start-bootflow",
      "expectMs": 20000,
      "dwellMs": 3000
    },
    {
      "name": "down-to-options",
      "key": "DOWN",
      "holdMs": 2000,
      "holdUntilConfirmed": true,
      "maxPulses": 2,
      "gapMs": 1500,
      "dwellMs": 1500
    },
    {
      "name": "open-options",
      "key": "A",
      "holdMs": 2000,
      "holdUntilConfirmed": true,
      "maxPulses": 1,
      "expect": "\\[SR_FSCMD\\].*menu button=2",
      "expectMs": 10000
    },
    {
      "name": "live-report-fe",
      "purpose": "the game's own getters, right before the open",
      "expect": "\\[SR_FSCMD\\].*SR_GameOptionsLive 'FE \\d+' -> noted",
      "expectSince": "open-options",
      "expectMs": 10000
    },
    {
      "name": "options-shown-fe",
      "expect": "\\[PC_SETTINGS\\] shown \\(FE",
      "expectSince": "open-options",
      "expectMs": 15000,
      "dwellMs": 3000
    },
    {
      "name": "preview-invert-on",
      "purpose": "GAME is the first tab, INVERT LOOK its first row",
      "key": "RIGHT",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 1500,
      "expect": "\\[PC_SETTINGS\\] preview game_invert_y = on",
      "expectMs": 8000
    },
    {
      "name": "setters-fe",
      "purpose": "the next Apt pump calls the opener's own SR_GameOptions (a preview: stored -1)",
      "expect": "\\[GAME_OPTIONS\\] _global\\.SRFrontEnd\\.SR_GameOptions\\(\\d+, -1\\) called",
      "expectSince": "preview-invert-on",
      "expectMs": 8000
    },
    {
      "name": "applied-by-game-fe",
      "purpose": "ApplyStore: the game's own setters, the live options now match",
      "expect": "\\[SR_FSCMD\\].*apply why=3 store=\\d+ now=\\d+ match=true",
      "expectSince": "preview-invert-on",
      "expectMs": 8000
    },
    {
      "name": "apply-fe",
      "key": "Y",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 2000,
      "expect": "\\[PC_SETTINGS\\] game_invert_y = on \\(applied, stored\\)",
      "expectMs": 8000
    },
    {
      "name": "stored-fe",
      "expect": "\\[GAME_OPTIONS\\] _global\\.SRFrontEnd\\.SR_GameOptions\\(\\d+, \\d+\\) called .*invY=1",
      "expectSince": "apply-fe",
      "expectMs": 8000
    },
    {
      "name": "close-fe",
      "key": "B",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 3000,
      "expect": "\\[PC_SETTINGS\\] close",
      "expectMs": 8000
    },
    {
      "name": "menu-again",
      "expect": "\\[MENU_CENSUS\\].*page='MAIN MENU'",
      "expectSince": "close-fe",
      "expectMs": 15000,
      "dwellMs": 2000
