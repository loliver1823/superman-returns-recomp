      "expectMs": 180000
    },
    {
      "name": "play",
      "dwellMs": 30000
    },
    {
      "name": "pause",
      "key": "ENTER",
      "holdMs": 2000,
      "holdUntilConfirmed": true,
      "maxPulses": 18,
      "gapMs": 10000,
      "expect": "\\[SR_FSCMD\\].*SR_Log 'pause install'",
      "expectFresh": true,
      "expectMs": 10000,
      "dwellMs": 3000
    },
    {
