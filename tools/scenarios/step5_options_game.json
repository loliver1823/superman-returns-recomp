      "key": "B",
      "holdMs": 250,
      "maxPulses": 1,
      "expect": "\\[SR_FSCMD\\].*SR_SetSettings 'ScrControllerOpt PAUSEMENU \\d+' -> stored",
      "expectMs": 15000,
      "dwellMs": 4000
