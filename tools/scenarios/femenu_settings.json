{
  "name": "femenu-settings",
  "purpose": "lane E L-b (was iter-463 step 7): the universal options with the one OPTIONS screen. MAIN MENU > OPTIONS: the GAME tab's INVERT LOOK through the game's own setters (apply why=3 match=true), APPLY stores it; NEW GAME re-applies the store (apply why=1 match=true); in game pause > OPTIONS (lane E L-c: the 9-row pause menu has no retail GAMEPLAY OPTIONS row): the game's own getters report invY=1, the GAME tab's AUTO-CENTRE off APPLIED stores invY=1 autoCenter=0 (the front end's change is the game's own option in game). -TimeoutSeconds 420.",
  "gates": "SR_KB_PAD_OBS=1,SR_PRESENT_DUMP=1,SR_PRESENT_DUMP_SPARSE_EVERY=20,SR_PRESENT_DUMP_SPARSE_CAP=900",
  "steps": [
    {
      "name": "fe-alive",
      "await": "\\[NAT_FE\\] #1 natural FE master tick",
      "timeoutMs": 180000
    },
    {
      "name": "settle-title",
      "await": "\\[NAT_FE\\] #256 natural FE master tick",
      "timeoutMs": 180000
    },
    {
      "name": "press-start",
      "key": "ENTER",
      "holdMs": 250,
      "maxPulses": 4,
      "gapMs": 12000,
      "expect": "\\[APT_SCREEN\\] path='main'|\\[APT_LOADMOVIE\\].*\\(\"main\"\\)",
      "expectMs": 90000
    },
    {
      "name": "title-ui-tail",
      "await": "\\[APT_REQ\\] #15 path='\\.\\./common/ButtonHints/XBox360/HintB'",
      "timeoutMs": 240000
    },
    {
      "name": "title-visible",
      "requireVisibleMs": 8000,
      "visibleTimeoutMs": 200000,
      "dwellMs": 6000
    },
    {
      "name": "start-bootflow",
      "key": "ENTER",
      "holdMs": 250,
      "maxPulses": 1,
      "expect": "\\[SR_FSCMD\\].*claim LoadCreate",
      "expectMs": 30000
    },
    {
      "name": "menu-visible",
      "dwellMs": 4000
    },
    {
      "name": "fe-down-to-options",
      "key": "DOWN",
      "holdMs": 250,
      "maxPulses": 2,
      "gapMs": 1500,
      "dwellMs": 1500
    },
    {
      "name": "fe-open-options",
      "key": "A",
      "holdMs": 250,
      "maxPulses": 1,
      "dwellMs": 3000,
      "expect": "\\[SR_FSCMD\\].*menu button=2",
      "expectMs": 10000,
      "purpose": "lane E L-b: MAIN MENU > OPTIONS opens the OPTIONS screen directly (its GAME tab first)"
    },
    {
      "name": "fe-options-shown",
      "expect": "\\[PC_SETTINGS\\] shown \\(FE",
      "expectSince": "fe-open-options",
      "expectMs": 15000,
      "dwellMs": 2000
    },
    {
      "name": "invert-on",
      "key": "RIGHT",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 1500,
      "expect": "\\[PC_SETTINGS\\] preview game_invert_y = on",
      "expectMs": 8000
    },
    {
      "name": "applied-by-game",
      "expect": "\\[SR_FSCMD\\].*apply why=3 store=\\d+ now=\\d+ match=true",
      "expectSince": "invert-on",
      "expectMs": 8000
    },
    {
      "name": "apply",
      "key": "Y",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 2000,
      "expect": "\\[PC_SETTINGS\\] game_invert_y = on \\(applied, stored\\)",
      "expectMs": 8000
    },
    {
      "name": "close",
      "key": "B",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 3000,
      "expect": "\\[PC_SETTINGS\\] close",
      "expectMs": 8000
    },
    {
      "name": "up-to-new",
      "key": "UP",
      "holdMs": 250,
      "maxPulses": 2,
      "gapMs": 1500,
      "dwellMs": 1500
    },
    {
      "name": "new-game",
      "key": "A",
      "holdMs": 250,
      "maxPulses": 1,
      "purpose": "VALUE check: after the game's own applyOptions reset Y inversion, ApplyStore made the live options equal the store (match=true; a no-op ApplyStore reads match=false).",
      "expect": "\\[SR_FSCMD\\].*apply why=1 store=\\d+ now=\\d+ match=true",
      "expectMs": 15000
    },
    {
      "name": "game-starts",
      "purpose": "The game's button-0 path runs (LoadComplete(true) -> IG). Not an APT_REQ expect: [APT_REQ] is capped at 24 lines (tools/audit_log_gating.py) and the settings trips use them up; the in-game capture below (PAUSEMENU tag) is the proof that gameplay was reached.",
      "expect": "\\[SR_FSCMD\\].*'uninstall'",
      "expectMs": 30000,
      "dwellMs": 5000
    },
    {
      "name": "play",
      "purpose": "Intro cinematic + first gameplay.",
      "dwellMs": 60000
    },
    {
      "name": "pause",
      "key": "ENTER",
      "holdMs": 250,
      "maxPulses": 1,
      "dwellMs": 5000
    },
    {
      "name": "up-to-options",
      "purpose": "lane E L-c: RESUME -> (wrap) QUIT GAME -> OPTIONS, the pause menu's own row (the hidden PHOTO MODE slot is skipped)",
      "key": "UP",
      "holdMs": 250,
      "maxPulses": 2,
      "gapMs": 1200,
      "dwellMs": 2500
    },
    {
      "name": "open-options",
      "key": "A",
      "holdMs": 250,
      "maxPulses": 1,
      "expect": "\\[PC_SETTINGS\\] shown \\(IG",
      "expectMs": 10000,
      "dwellMs": 3000
    },
    {
      "name": "live-report-in-game",
      "purpose": "VALUE check: the game's own getters in game report the front end's INVERT LOOK on and auto-centre still on - the menu's change carried into the game",
      "expect": "\\[SR_FSCMD\\].*SR_GameOptionsLive 'IG \\d+' -> noted \\(.* invY=1 autoCenter=1 ",
      "expectSince": "up-to-options",
      "expectMs": 10000
    },
    {
      "name": "down-to-autocenter",
      "purpose": "the GAME tab: INVERT LOOK (focused), AUTO-CENTRE",
      "key": "DOWN",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 1500
    },
    {
      "name": "change-in-game",
      "key": "RIGHT",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 2000,
      "expect": "\\[PC_SETTINGS\\] preview game_auto_center = off",
      "expectMs": 8000
    },
    {
      "name": "apply-in-game",
      "key": "Y",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 2000,
      "expect": "\\[PC_SETTINGS\\] game_auto_center = off \\(applied, stored\\)",
      "expectMs": 8000
    },
    {
      "name": "back-in-game",
      "purpose": "VALUE check: the store now holds auto-center off AND still Y inversion on (the same store the retail capture wrote before; femenu_settings_reboot.json seeds from it)",
      "expect": "\\[GAME_OPTIONS\\] _global\\.SRPause\\.SR_GameOptions\\(\\d+, \\d+\\) called .*invY=1 autoCenter=0 ",
      "expectSince": "apply-in-game",
      "expectMs": 10000
    },
    {
      "name": "close-in-game",
      "key": "B",
      "holdMs": 160,
      "maxPulses": 1,
      "dwellMs": 4000,
      "expect": "\\[PC_SETTINGS\\] close",
      "expectMs": 8000
    }
  ]
}
