; ScrMap.ExitScreen head (r1 = this, r2 = _global): _global.SRMap.Close(this), then delete it
; (the movie's functions must not outlive it)
    Push [reg1]
    EA_PushOne
    Push [reg2]
    Push ['SRMap']
    GetMember
    Push ['Close']
    CallMethod
    Pop
    Push [reg2]
    Push ['SRMap']
    Delete
    Pop
