    .func2 ''(r3 'what') flags=0x40129
        Push [reg3]
        EA_PushOne
        Equals2
        Not
        If oc_n1
        EA_PushOne
        EA_PushOne
        Push [reg1]
        EA_CallNamedMethodPop 'GoSettings'
        op_76
        Return
oc_n1:
        Push [reg3]
        EA_PushByte 2
        Equals2
        Not
