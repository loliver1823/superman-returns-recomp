        EA_PushByte 2
        EA_PushConstByte 'ShowMenu'
        Push [reg1]
        EA_PushConstByte 'FE'
        EA_PushConstByte 'main'
        EA_PushByte 5
        Push [reg2]
        EA_GetNamedMember 'SRDevTools'
        EA_CallNamedMethodPop 'Open'
        op_76
        Return
oc_n2:
        EA_PushByte 2
        EA_PushOne
        Push [reg1]
        EA_CallNamedMethodPop 'ShowMenu'
    .end
    SetMember

.include 'modopts_methods.aptasm'

