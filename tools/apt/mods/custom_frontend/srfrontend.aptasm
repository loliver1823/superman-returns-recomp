; fe.ShowMore(defBtn): MORE OPTIONS, in the same chrome (the pause menu has the same panel):
;   _global.FlowMgr.ShowGenPop("MORE OPTIONS", "Options of the PC version of the game.", 2,
;       defBtn, [this.AutosaveLabel(), "DEV TOOLS"], this.OnMore, this.OnReady, this, true,
