; fe.SR_OptionsClosed(what): the host's call once the OPTIONS screen is gone (kernel/game_options.hpp; the open hands
; the screen over with SR_DTEnd action 3, so nothing of ours was shown under it).
;   if (what == 1) { this.GoSettings(1); return; }   // VIEW PAD LAYOUT: the game's own CONTROLLER OPTIONS screen (its
;                                                    // pad diagrams; Y = AIR / GROUND); its back -> the menu (20_settings)
;   if (what == 2) { _global.SRDevTools.Open("main", "FE", this, "ShowMenu", 2); return; }   // DEV TOOLS (dev builds)
;   this.ShowMenu(2);                                // the MAIN MENU, OPTIONS focused
    Push [reg1]
