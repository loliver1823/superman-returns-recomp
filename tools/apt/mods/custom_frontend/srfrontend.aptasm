; fe.Defer(fn, arg): a popup callback runs BEFORE ScrGenPop closes its own popup
; (ScrGenPop.HandleInput: selectedCallback.call(...) then gPopupMgr.ClosePopup(this)), so
; a popup shown from inside the callback is lost (roll loadexit1: no APT_REQ, no panel).
; The game defers popups the same way: FlowMgr.CppShowPopup(bDelayBeforeShowing) ->
; setInterval(FlowMgr, "ShowPopupDelayed", 20, ...) (MainLib.as 0x2270-0x2344).
;   if (this.deferId != undefined) clearInterval(this.deferId);
;   this.deferFn = fn; this.deferArg = arg;
;   this.deferId = setInterval(this, "RunDeferred", 20);
    Push [reg1]
    EA_PushConstByte 'Defer'
    .func2 ''(r3 'fn', r4 'arg') flags=0x50129
        Push [reg1]
        EA_GetNamedMember 'deferId'
        op_76
        Equals2
        If df_clear
        Push [reg1]
        EA_GetNamedMember 'deferId'
        EA_PushOne
        EA_PushConstByte 'clearInterval'
        CallFunction
        Pop
df_clear:
        Push [reg1]
        EA_PushConstByte 'deferFn'
        Push [reg3]
        SetMember
        Push [reg1]
        EA_PushConstByte 'deferArg'
        Push [reg4]
        SetMember
        Push [reg1]
        EA_PushConstByte 'deferId'
        EA_PushByte 20
        EA_PushConstByte 'RunDeferred'
        Push [reg1]
        EA_PushByte 3
        EA_PushConstByte 'setInterval'
        CallFunction
        SetMember
    .end
    SetMember

; fe.RunDeferred(): the interval fires once.
;   clearInterval(this.deferId); this.deferId = undefined;
;   if (this.screen != undefined) this[this.deferFn](this.deferArg);   // ScrPressStart still up
    Push [reg1]
    EA_PushConstByte 'RunDeferred'
    .func2 ''() flags=0x30129
        Push [reg1]
        EA_GetNamedMember 'deferId'
        EA_PushOne
        EA_PushConstByte 'clearInterval'
        CallFunction
        Pop
        Push [reg1]
        EA_PushConstByte 'deferId'
        op_76
        SetMember
        Push [reg1]
        EA_GetNamedMember 'screen'
        op_76
        Equals2
        If rn_end
        Push [reg1]
        EA_GetNamedMember 'deferArg'
        EA_PushOne
        Push [reg1]
        Push [reg1]
        EA_GetNamedMember 'deferFn'
        CallMethod
        Pop
rn_end:
    .end
    SetMember

; ---- step 7: SETTINGS and the universal options (docs/CUSTOM_FRONTEND.md section 0) ----

; fe.ApplyStore(why): the universal store through the game's own SettingsAdapter setters
; (apply_store_fn.aptasm; the ScrSaveLoad patch splices its own copy of the same function).
    Push [reg1]
    EA_PushConstByte 'ApplyStore'
.include 'apply_store_fn.aptasm'
    SetMember

; fe.ShowSettings(defBtn): a second panel in the same chrome, the game's own screen names.
;   var L = _global.LocalizationAdapter;
;   _global.FlowMgr.ShowGenPop("SETTINGS", "SUPERMAN RETURNS: THE VIDEOGAME", 3, defBtn,
;       [L.GetLocalizedText("Label_ScrGameplayOpt"), L.GetLocalizedText("Label_ScrControllerOpt"),
;        L.GetLocalizedText("Label_ScrAudioOpt")],
;       this.OnSettings, this.OnReady, this, true /*B = back*/, true, 29153);
    Push [reg1]
    EA_PushConstByte 'ShowSettings'
    .func2 ''(r3 'defBtn') flags=0x50129
        Push [reg2]
        EA_GetNamedMember 'LocalizationAdapter'
        StoreRegister 4
        Pop
        EA_PushShort 29153
        op_73
        op_73
        Push [reg1]
        Push [reg1]
        EA_GetNamedMember 'OnReady'
        Push [reg1]
        EA_GetNamedMember 'OnSettings'
        EA_PushConstByte 'MORE OPTIONS'
        EA_PushConstByte 'DISPLAY OPTIONS'
        EA_PushConstByte 'Label_ScrAudioOpt'
        EA_PushOne
        Push [reg4]
        EA_PushConstByte 'GetLocalizedText'
        CallMethod
        EA_PushConstByte 'Label_ScrControllerOpt'
        EA_PushOne
        Push [reg4]
        EA_PushConstByte 'GetLocalizedText'
        CallMethod
        EA_PushConstByte 'Label_ScrGameplayOpt'
        EA_PushOne
        Push [reg4]
        EA_PushConstByte 'GetLocalizedText'
        CallMethod
        EA_PushByte 5
        InitArray
        Push [reg3]
        EA_PushByte 5
        EA_PushConstByte 'SUPERMAN RETURNS: THE VIDEOGAME'
        EA_PushConstByte 'SETTINGS'
        EA_PushByte 11
        Push [reg2]
        EA_GetNamedMember 'FlowMgr'
        EA_CallNamedMethodPop 'ShowGenPop'
    .end
    SetMember

; fe.OnSettings(popup, button): B (-1) -> the 4-button menu (SETTINGS focused); a row ->
; open that options screen (deferred, like every chained popup / switch here).
;   fscommand("SR_Log", "settings button=" + button);
;   if (button < 0) this.Defer("ShowMenu", 2); else this.Defer("GoSettings", button);
    Push [reg1]
    EA_PushConstByte 'OnSettings'
    .func2 ''(r3 'popup', r4 'button') flags=0x50129
        EA_PushConstByte 'FSCommand:SR_Log'
        EA_PushConstByte 'settings button='
        Push [reg4]
        Add2
        GetURL2
        Push [reg4]
        EA_PushZero
        Less2
        Not
        If os_open
        EA_PushByte 2
        EA_PushConstByte 'ShowMenu'
        EA_PushByte 2
        Push [reg1]
        EA_CallNamedMethodPop 'Defer'
        op_76
        Return
os_open:
        Push [reg4]
        EA_PushByte 3
        Equals2
        Not
        If os_n3
        EA_PushByte 3
        EA_PushConstByte 'OpenDisplay'
        EA_PushByte 2
        Push [reg1]
        EA_CallNamedMethodPop 'Defer'
        op_76
        Return
os_n3:
        Push [reg4]
        EA_PushByte 4
        Equals2
        Not
        If os_n4
        EA_PushZero
        EA_PushConstByte 'ShowMore'
        EA_PushByte 2
        Push [reg1]
        EA_CallNamedMethodPop 'Defer'
        op_76
        Return
os_n4:
        Push [reg4]
        EA_PushConstByte 'GoSettings'
        EA_PushByte 2
        Push [reg1]
        EA_CallNamedMethodPop 'Defer'
    .end
    SetMember

; fe.GoSettings(i): opens the game's options screen as an OVERLAY screen at depth 60
; (between LEVELS.MAIN 50 and FOREGROUND 75; MainLib: FlowMgr.SwitchLevel("NONE", id, lvl)
; -> gSM.LoadOverlayScreen), so ScrPressStart stays loaded underneath. The screen manager
; hands input to the top of its screen stack first, and the options screens return false
; (consumed), so ScrPressStart does not see it. Not SwitchScreen at MAIN (what ScrPauseMenu
; does): rolls settings/set1, set2 and back1 showed that a ScrPressStart reloaded in the
; same session runs onLoad but never reaches InitGui (no 'initgui'/'install', its slot
; picker left visible, input locked). Cause found later: the .const walk order broke the
; runtime's unload renumbering (docs/CUSTOM_FRONTEND.md 5.4 item 4, fixed in the toolchain);
; the overlay stays until a live roll shows the reload working.
; The options screens' HandleInput patch (20_settings.patch) unloads the overlay on B /
; Esc / START and re-shows the menu.
;   var S = _global.SCREEN, id = S.GAMEPLAY_OPT;
;   if (i == 1) id = S.CONTROLLER_OPT; if (i == 2) id = S.AUDIO_OPT;
;   this.inSettings = true; fscommand("SR_Log", "settings open " + id);
;   this.settingsScreen = id;
;   _global.SetFortressDisplayWell(true);          // the panel + title (review finding 5)
;   _global.FlowMgr.SwitchLevel("NONE", id, 60);   // an OVERLAY screen at depth 60
; SetFortressDisplayWell(true): the DisplayWell panel and the screen title the Audio and
; Controller screens show outside the pause menu (their InitGui calls it there; ScrAudioOpt
; 0x0052C). ScrGameplayOpt's InitGui never does (retail opens it only from the pause menu,
; which draws its own well), so without it its rows and title-less hints floated over the
; flyby (roll settings/reboot1 frames 133-142). The call is the game's own ScrBackground_IG
; helper (visible + title position 60; it never clears the title when true), idempotent for
; the two screens that call it themselves; the options HandleInput patch hides it on back.
    Push [reg1]
    EA_PushConstByte 'GoSettings'
    .func2 ''(r3 'i') flags=0x60129
        Push [reg2]
        EA_GetNamedMember 'SCREEN'
        StoreRegister 4
        Pop
        Push [reg4]
        EA_GetNamedMember 'GAMEPLAY_OPT'
        StoreRegister 5
        Pop
        Push [reg3]
        EA_PushOne
        Equals2
        Not
        If gs_n1
        Push [reg4]
        EA_GetNamedMember 'CONTROLLER_OPT'
        StoreRegister 5
        Pop
gs_n1:
        Push [reg3]
        EA_PushByte 2
        Equals2
        Not
        If gs_n2
        Push [reg4]
        EA_GetNamedMember 'AUDIO_OPT'
        StoreRegister 5
        Pop
gs_n2:
        Push [reg1]
        EA_PushConstByte 'inSettings'
        op_73
        SetMember
        EA_PushConstByte 'FSCommand:SR_Log'
        EA_PushConstByte 'settings open '
        Push [reg5]
        Add2
        GetURL2
        Push [reg1]
        EA_PushConstByte 'settingsScreen'
        Push [reg5]
        SetMember
        op_73
        EA_PushOne
        Push [reg2]
        EA_CallNamedMethodPop 'SetFortressDisplayWell'
        EA_PushByte 60
        Push [reg5]
        EA_PushConstByte 'NONE'
        EA_PushByte 3
        Push [reg2]
        EA_GetNamedMember 'FlowMgr'
        EA_CallNamedMethodPop 'SwitchLevel'
    .end
    SetMember

; ---- iter-464: DEV TOOLS from the SETTINGS panel, and the shared mod-option methods ----

; fe.OpenDevTools(defBtn): the Dev Tools pages (devtools_ui.aptasm, bound by this movie's
