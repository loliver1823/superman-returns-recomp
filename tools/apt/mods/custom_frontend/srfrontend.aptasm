; fe.ShowExitConfirm(): the same shape as ScrPauseMenu.showWarning (0x0E8C-0x1048).
;   var L = _global.LocalizationAdapter;
;   _global.FlowMgr.ShowGenPop(L.GetLocalizedText("Generic_WARNING"), "QUIT TO DESKTOP?", 2, 0,
;       [L.GetLocalizedText("Generic_NO"), L.GetLocalizedText("Generic_YES")],
