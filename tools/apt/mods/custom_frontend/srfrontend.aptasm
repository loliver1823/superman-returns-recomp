; fe.OnExit(popup, button): YES (1) quits through the host bridge; NO (0) or B (-1)
; returns to the menu with EXIT focused.
;   if (button == 1) fscommand("SR_Quit", ""); else this.Defer("ShowMenu", 4);
    Push [reg1]
    EA_PushConstByte 'OnExit'
    .func2 ''(r3 'popup', r4 'button') flags=0x50129
        Push [reg4]
        EA_PushOne
        Equals2
        Not
        If ex_back
        GetURL 'FSCommand:SR_Quit', ''
