; fe.OnMore(popup, button): B -> SETTINGS (MORE OPTIONS focused); 0 -> flip AUTOSAVE WITHOUT
; ASKING (the host stores it) and show the panel again; 1 -> the Dev Tools pages.
;   fscommand("SR_Log", "more button=" + button);
;   if (button < 0) this.Defer("ShowSettings", 4);
;   else if (button == 0) { this.ToggleAutosave(); this.Defer("ShowMore", 0); }
;   else this.Defer("OpenDevTools", 1);
    Push [reg1]
