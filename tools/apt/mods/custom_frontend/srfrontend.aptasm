        EA_PushByte 5
        Push [reg2]
        EA_GetNamedMember 'SRDevTools'
        EA_CallNamedMethodPop 'Open'
    .end
    SetMember

; ---- iter-465 polish: DISPLAY OPTIONS and the MORE OPTIONS panel ----

