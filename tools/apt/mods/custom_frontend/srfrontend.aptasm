; Appended to ScrPressStart's class InitAction (sprite 61), after its guarded class
; definition, so it runs on EVERY load of the movie. Pseudo-AS:
;
;   if (_global.SRFrontEnd == undefined) {           // plain state: survives unloads
;     _global.SRFrontEnd = new Object();
;     _global.SRFrontEnd.inSettings = false;          // pendingId starts undefined
;   }
;   var fe = _global.SRFrontEnd;                      // functions: re-bound every load
;   fe.Install = ...; fe.Uninstall = ...; fe.CppShowPopupHook = ...; fe.IsLoadCreate = ...;
;   fe.ShowMenu = ...; fe.OnReady = ...; fe.GenPopInputHook = ...; fe.OnMenu = ...;
;   fe.ShowExitConfirm = ...; fe.OnExit = ...; fe.Defer / RunDeferred;
;   (ScrPressStart.ExitScreen deletes every one of these methods again after Uninstall:
;   exitscreen_head.aptasm; a new method must be added to that list - the build checks it)
;   step 7: fe.ApplyStore, fe.ShowSettings, fe.OnSettings, fe.GoSettings and
;   FlowMgr.SR_OnHostSettings (the host's SR_GetSettings reply).
;   iter-464: fe.OpenDevTools + the shared mod-option methods (modopts_methods.aptasm:
;   AutosaveOn, AutosaveLabel, OnModOptions, FetchModOptions, ToggleAutosave); the SETTINGS
;   panel gains AUTOSAVE WITHOUT ASKING and DEV TOOLS.
;   iter-465 polish: SETTINGS = GAMEPLAY / CONTROLLER / AUDIO / DISPLAY OPTIONS / MORE OPTIONS
;   (fe.OpenDisplay = the host-built DISPLAY OPTIONS page; fe.ShowMore / fe.OnMore = the
;   MORE OPTIONS panel: AUTOSAVE WITHOUT ASKING, DEV TOOLS - as the pause menu's). FlowMgr.CppShowPopup hook ownership is
;   shared with MAIN_HUD's autosave hook (SR_PopupHookOwner "fe" / "hud"; one
;   SR_OrigCppShowPopup slot holds the game's own function).
; Plain state in _global.SRFrontEnd: pendingId, inSettings, fetched, lastAnswer, deferId...;
; the universal options live in _global.SRSettings (packed, kernel/mod_bridge.hpp).
;
; Strings are constant-pool entries (EA_PushConstByte), as retail code pushes them; the
; only static strings are the GetURL operands. fscommand("SR_Log", s) is GetURL2 with
; "FSCommand:SR_Log" (AsInterpretBytecode 0x82688B90 -> handler table 0x82931420[0x9A] =
; AptAS2ActionGetURL2LoadMovie_sub_826BB0F0: no operand byte, pops url then target,
; "FSCommand:" prefix -> sub_82682DF8 -> the host bridge, kernel/mod_bridge.cpp).
; In every function reg1 = this and reg2 = _global (flags 0x..0129).

    op_71
    EA_GetNamedMember 'SRFrontEnd'
    op_76
    Equals2
    Not
    If sr_have
    op_71
    EA_PushConstByte 'SRFrontEnd'
    EA_PushZero
    EA_PushConstByte 'Object'
    NewObject
    SetMember
    op_71
    EA_GetNamedMember 'SRFrontEnd'
    EA_PushConstByte 'inSettings'
    op_74
    SetMember
sr_have:
    op_71
    EA_GetNamedMember 'SRFrontEnd'
    StoreRegister 1
    Pop

; fe.Install(screen) -> true when a pending menu must be re-shown (back from SETTINGS).
;   if (!this.fetched) { this.fetched = true; fscommand("SR_GetSettings", ""); }
;       // once per process: the host answers synchronously with
;       // FlowMgr.SR_OnHostSettings(packed) (bound by this movie's InitAction), which
;       // stores _global.SRSettings (section 0)
;   var fm = _global.FlowMgr;
;   if (fm.SR_OrigCppShowPopup == undefined) {
;     fm.SR_OrigCppShowPopup = fm.CppShowPopup; fm.CppShowPopup = this.CppShowPopupHook; }
;   this.screen = screen;
;   if (!this.inSettings) { this.pendingId = undefined; return false; }   // stale-state guard
;   this.inSettings = false; return this.pendingId != undefined;
    Push [reg1]
    EA_PushConstByte 'Install'
    .func2 ''(r3 'screen') flags=0x50129
        GetURL 'FSCommand:SR_Log', 'install'
        Push [reg1]
        EA_GetNamedMember 'fetched'
        If in_fetched
        Push [reg1]
        EA_PushConstByte 'fetched'
        op_73
        SetMember
        GetURL 'FSCommand:SR_GetSettings', ''
in_fetched:
        Push [reg2]
        EA_GetNamedMember 'FlowMgr'
        StoreRegister 4
        Pop
        Push [reg4]
        EA_GetNamedMember 'SR_OrigCppShowPopup'
        op_76
        Equals2
        Not
        If in_haveorig
        Push [reg4]
        EA_PushConstByte 'SR_OrigCppShowPopup'
        Push [reg4]
        EA_GetNamedMember 'CppShowPopup'
        SetMember
in_haveorig:
        Push [reg4]
        EA_PushConstByte 'CppShowPopup'
        Push [reg1]
        EA_GetNamedMember 'CppShowPopupHook'
        SetMember
        Push [reg4]
        EA_PushConstByte 'SR_PopupHookOwner'
        EA_PushConstByte 'fe'
        SetMember
        EA_PushZero
        Push [reg1]
        EA_CallNamedMethodPop 'FetchModOptions'
        Push [reg1]
        EA_PushConstByte 'screen'
        Push [reg3]
        SetMember
        Push [reg1]
        EA_GetNamedMember 'inSettings'
        If in_resume
        Push [reg1]
        EA_PushConstByte 'pendingId'
        op_76
        SetMember
        op_74
        Return
in_resume:
        Push [reg1]
        EA_PushConstByte 'inSettings'
        op_74
        SetMember
        Push [reg1]
        EA_GetNamedMember 'pendingId'
        op_76
        Equals2
        Not
        Return
    .end
    SetMember

; fe.Uninstall(): undo everything Install / OnReady installed.
;   var fm = _global.FlowMgr;
;   if (fm.SR_OrigCppShowPopup != undefined) {
;     fm.CppShowPopup = fm.SR_OrigCppShowPopup; delete fm.SR_OrigCppShowPopup; }
;   delete fm.SR_OnHostSettings;
;   var p = _global.ScrGenPop.prototype;
;   if (p.SR_OrigHandleInput != undefined) {
;     p.HandleInput = p.SR_OrigHandleInput; delete p.SR_OrigHandleInput; }
;   if (this.deferId != undefined) { clearInterval(this.deferId); this.deferId = undefined; }
;   this.screen = undefined;
;   if (!this.inSettings) this.pendingId = undefined;
    Push [reg1]
    EA_PushConstByte 'Uninstall'
    .func2 ''() flags=0x50129
        GetURL 'FSCommand:SR_Log', 'uninstall'
        Push [reg2]
        EA_GetNamedMember 'FlowMgr'
        StoreRegister 3
        Pop
        Push [reg3]
        EA_GetNamedMember 'SR_PopupHookOwner'
        EA_PushConstByte 'fe'
        Equals2
        Not
        If un_nohook
        Push [reg3]
        EA_PushConstByte 'CppShowPopup'
        Push [reg3]
        EA_GetNamedMember 'SR_OrigCppShowPopup'
        SetMember
        Push [reg3]
        EA_PushConstByte 'SR_OrigCppShowPopup'
        Delete
        Pop
        Push [reg3]
        EA_PushConstByte 'SR_PopupHookOwner'
        Delete
        Pop
un_nohook:
        Push [reg3]
        EA_PushConstByte 'SR_OnHostSettings'
        Delete
        Pop
        Push [reg2]
        EA_GetNamedMember 'ScrGenPop'
        EA_GetNamedMember 'prototype'
        StoreRegister 4
        Pop
        Push [reg4]
        EA_GetNamedMember 'SR_OrigHandleInput'
        op_76
        Equals2
        If un_noinput
        Push [reg4]
        EA_PushConstByte 'HandleInput'
        Push [reg4]
        EA_GetNamedMember 'SR_OrigHandleInput'
        SetMember
        Push [reg4]
        EA_PushConstByte 'SR_OrigHandleInput'
        Delete
        Pop
un_noinput:
        Push [reg1]
        EA_GetNamedMember 'deferId'
        op_76
        Equals2
        If un_nodefer
        Push [reg1]
        EA_GetNamedMember 'deferId'
        EA_PushOne
        EA_PushConstByte 'clearInterval'
        CallFunction
        Pop
        Push [reg1]
        EA_PushConstByte 'deferId'
        op_76
        SetMember
un_nodefer:
        Push [reg1]
        EA_PushConstByte 'screen'
        op_76
        SetMember
        Push [reg1]
        EA_GetNamedMember 'inSettings'
        If un_keep
        Push [reg1]
        EA_PushConstByte 'pendingId'
        op_76
        SetMember
un_keep:
    .end
    SetMember

; fe.CppShowPopupHook(t, b, n, def, opts, can, close, col, cppId, delay): installed as
; _global.FlowMgr.CppShowPopup (same 10 arguments, MainLib.as 0x2345). The C++ reaches
; it by name each call (sub_822B15F8 -> AptExecutor vt+32). Claims only the 2-button
; LoadCreate popup; everything else goes to the game's own function unchanged.
;   var fe = _global.SRFrontEnd;
;   if (n == 2 && fe.IsLoadCreate(t, opts)) {
;     fe.pendingId = cppId; fscommand("SR_Log", "claim LoadCreate cppId=" + cppId);
;     fe.ApplyStore(0);   // the universal options win over the sign-in applyOptions
;     fe.ShowMenu(0); return;
;   }
;   _global.FlowMgr.SR_OrigCppShowPopup(t, b, n, def, opts, can, close, col, cppId, delay);
    Push [reg1]
    EA_PushConstByte 'CppShowPopupHook'
    .func2 ''(r3 't', r4 'b', r5 'n', r6 'def', r7 'opts', r8 'can', r9 'close', r10 'col', r11 'cppId', r12 'delay') flags=0xE0129
        Push [reg2]
        EA_GetNamedMember 'SRFrontEnd'
        StoreRegister 13
        Pop
        Push [reg5]
        EA_PushByte 2
        Equals2
        Not
        If hk_pass
        Push [reg7]
        Push [reg3]
        EA_PushByte 2
        Push [reg13]
        EA_PushConstByte 'IsLoadCreate'
        CallMethod
        Not
        If hk_pass
        Push [reg13]
        EA_PushConstByte 'pendingId'
        Push [reg11]
        SetMember
        EA_PushConstByte 'FSCommand:SR_Log'
        EA_PushConstByte 'claim LoadCreate cppId='
        Push [reg11]
        Add2
        GetURL2
        EA_PushZero
        EA_PushOne
        Push [reg13]
        EA_CallNamedMethodPop 'ApplyStore'
        EA_PushZero
        EA_PushOne
        Push [reg13]
        EA_CallNamedMethodPop 'ShowMenu'
        op_76
        Return
hk_pass:
        Push [reg12]
        Push [reg11]
        Push [reg10]
        Push [reg9]
        Push [reg8]
        Push [reg7]
        Push [reg6]
        Push [reg5]
        Push [reg4]
        Push [reg3]
        EA_PushByte 10
        Push [reg2]
        EA_GetNamedMember 'FlowMgr'
        EA_CallNamedMethodPop 'SR_OrigCppShowPopup'
    .end
    SetMember

; fe.IsLoadCreate(t, opts): structural marker = the game's own text keys, raw or localized
; (sub_822B4C50 passes LoadCreate_Profile_Title / [LoadCreate_Create_Btn, _Load_Btn]).
; The title alone is NOT enough: PromptIGLoad_Title (sub_822B4ED8, also 2 buttons, colour
; 29153, buttons off_82913818 = [PromptIGLoad_Load_Btn, _Cancel_Btn]) reads "LOAD A GAME?"
; too, so the title AND the first button must both be LoadCreate's.
;   var L = _global.LocalizationAdapter; var o = opts[0];
;   return (t == "LoadCreate_Profile_Title" || t == L.GetLocalizedText("LoadCreate_Profile_Title"))
;       && (o == "LoadCreate_Create_Btn"    || o == L.GetLocalizedText("LoadCreate_Create_Btn"));
    Push [reg1]
    EA_PushConstByte 'IsLoadCreate'
    .func2 ''(r3 't', r4 'opts') flags=0x70129
        Push [reg2]
        EA_GetNamedMember 'LocalizationAdapter'
        StoreRegister 5
        Pop
        Push [reg4]
        EA_PushZero
        GetMember
        StoreRegister 6
        Pop
        Push [reg3]
        EA_PushConstByte 'LoadCreate_Profile_Title'
        Equals2
        If lc_title
        Push [reg3]
        EA_PushConstByte 'LoadCreate_Profile_Title'
        EA_PushOne
        Push [reg5]
        EA_PushConstByte 'GetLocalizedText'
        CallMethod
        Equals2
        If lc_title
        op_74
        Return
lc_title:
        Push [reg6]
        EA_PushConstByte 'LoadCreate_Create_Btn'
        Equals2
        If lc_yes
        Push [reg6]
        EA_PushConstByte 'LoadCreate_Create_Btn'
        EA_PushOne
        Push [reg5]
        EA_PushConstByte 'GetLocalizedText'
        CallMethod
        Equals2
        If lc_yes
        op_74
        Return
lc_yes:
        op_73
        Return
    .end
    SetMember

; fe.ShowMenu(defBtn): the game's own popup helper, the same chrome as LOAD A GAME?
;   _global.FlowMgr.ShowGenPop("MAIN MENU", "SUPERMAN RETURNS: THE VIDEOGAME", 5, defBtn,
;       ["NEW GAME", "LOAD GAME", "SETTINGS", "MODS", "EXIT"], this.OnMenu, this.OnReady, this,
;       true /*canCancel*/, true /*closeOnPress*/, 29153 /*GENPOP_BLUE*/);
;   (iter-464 modmenu: MODS = row 3, EXIT moved to row 4; 5 = ScrGenPop's MAXNUMBUTTONS)
;   (lane E E4, owner Q4 (b) 2026-10-23: B on the MAIN MENU asks QUIT TO DESKTOP?, the PC convention - canCancel, and
;    OnMenu treats the cancel (-1) as EXIT; the game's popup then shows "B BACK", 60_genpop_hints.patch)
    Push [reg1]
    EA_PushConstByte 'ShowMenu'
    .func2 ''(r3 'defBtn') flags=0x40129
        EA_PushShort 29153
        op_73
        op_73
        Push [reg1]
        Push [reg1]
        EA_GetNamedMember 'OnReady'
        Push [reg1]
        EA_GetNamedMember 'OnMenu'
        EA_PushConstByte 'EXIT'
        EA_PushConstByte 'MODS'
        EA_PushConstByte 'OPTIONS'
        EA_PushConstByte 'LOAD GAME'
        EA_PushConstByte 'NEW GAME'
        EA_PushByte 5
        InitArray
        Push [reg3]
        EA_PushByte 5
        EA_PushConstByte 'SUPERMAN RETURNS: THE VIDEOGAME'
        EA_PushConstByte 'MAIN MENU'
        EA_PushByte 11
        Push [reg2]
        EA_GetNamedMember 'FlowMgr'
        EA_CallNamedMethodPop 'ShowGenPop'
    .end
    SetMember

; fe.OnReady(): ScrGenPop.PopupInit's readyCallBack (context = fe). Stamps the time the
; panel came up and wraps ScrGenPop.prototype.HandleInput once (the class exists by now).
;   this.shownAt = getTimer();
;   var p = _global.ScrGenPop.prototype;
;   if (p.SR_OrigHandleInput == undefined) {
;     p.SR_OrigHandleInput = p.HandleInput; p.HandleInput = this.GenPopInputHook; }
    Push [reg1]
    EA_PushConstByte 'OnReady'
    .func2 ''() flags=0x40129
        Push [reg1]
        EA_PushConstByte 'shownAt'
        GetTime
        SetMember
        Push [reg2]
        EA_GetNamedMember 'ScrGenPop'
        EA_GetNamedMember 'prototype'
        StoreRegister 3
        Pop
        Push [reg3]
        EA_GetNamedMember 'SR_OrigHandleInput'
        op_76
        Equals2
        Not
        If rd_done
        Push [reg3]
        EA_PushConstByte 'SR_OrigHandleInput'
        Push [reg3]
        EA_GetNamedMember 'HandleInput'
        SetMember
        Push [reg3]
        EA_PushConstByte 'HandleInput'
        Push [reg1]
        EA_GetNamedMember 'GenPopInputHook'
        SetMember
rd_done:
    .end
    SetMember

; fe.GenPopInputHook(keyCode, controllerId, ascii): ScrGenPop.prototype.HandleInput while
; ScrPressStart is loaded; this = the popup. Only OUR popups (context == fe) are touched:
; the keyboard's Enter (pad START) selects like A once the panel has been up 400 ms (the
; press that started the boot flow must not pick NEW GAME), and Esc/Backspace (pad BACK =
; INPUTCODE.SELECT) backs out like B. Every other popup runs the original unchanged.
;   var fe = _global.SRFrontEnd;
;   if (this.mParams.context == fe) {
;     fscommand("SR_Log", "menu key=" + keyCode);
;     if (keyCode == INPUTCODE.START) {
;       if (!(getTimer() - fe.shownAt > 400)) return false;
;       keyCode = INPUTCODE.CROSS;
;     } else if (keyCode == INPUTCODE.SELECT) keyCode = INPUTCODE.TRIANGLE;
;   }
;   return this.SR_OrigHandleInput(keyCode, controllerId, ascii);
    Push [reg1]
    EA_PushConstByte 'GenPopInputHook'
    .func2 ''(r3 'keyCode', r4 'controllerId', r5 'ascii') flags=0x70129
        Push [reg2]
        EA_GetNamedMember 'SRFrontEnd'
        StoreRegister 6
        Pop
        Push [reg1]
        EA_GetNamedMember 'mParams'
        EA_GetNamedMember 'context'
        Push [reg6]
        Equals2
        Not
        If gk_notfe
        EA_PushConstByte 'FSCommand:SR_Log'
        EA_PushConstByte 'menu key='
        Push [reg3]
        Add2
        GetURL2
        Push [reg3]
        Push [reg2]
        EA_GetNamedMember 'INPUTCODE'
        EA_GetNamedMember 'START'
        Equals2
        Not
        If gk_notstart
        GetTime
        Push [reg6]
        EA_GetNamedMember 'shownAt'
        Subtract
        EA_PushShort 400
        Greater
        If gk_start_ok
        op_74
        Return
gk_start_ok:
        Push [reg2]
        EA_GetNamedMember 'INPUTCODE'
        EA_GetNamedMember 'CROSS'
        StoreRegister 3
        Pop
        Jump gk_orig
gk_notstart:
        Push [reg3]
        Push [reg2]
        EA_GetNamedMember 'INPUTCODE'
        EA_GetNamedMember 'SELECT'
        Equals2
        Not
        If gk_orig
        Push [reg2]
        EA_GetNamedMember 'INPUTCODE'
        EA_GetNamedMember 'TRIANGLE'
        StoreRegister 3
        Pop
        Jump gk_orig
gk_notfe:
        Push [reg1]
        EA_GetNamedMember 'mParams'
        EA_GetNamedMember 'context'
        Push [reg2]
        EA_GetNamedMember 'SRDevTools'
        Equals2
        Not
        If gk_orig
        Push [reg3]
        Push [reg1]
        EA_PushByte 2
        Push [reg2]
        EA_GetNamedMember 'SRDevTools'
        EA_PushConstByte 'PopupKey'
        CallMethod
        StoreRegister 3
        Pop
        Push [reg3]
        EA_PushZero
        Less2
        Not
        If gk_orig
        op_74
        Return
gk_orig:
        Push [reg5]
        Push [reg4]
        Push [reg3]
        EA_PushByte 3
        Push [reg1]
        EA_PushConstByte 'SR_OrigHandleInput'
        CallMethod
        Return
    .end
    SetMember

; fe.OnMenu(popup, button): the menu's selectedCallback (context = fe).
;   fscommand("SR_Log", "menu button=" + button);
;   if (button == 0 || button == 1) {                 // NEW GAME / LOAD GAME
;     var id = this.pendingId;
;     if (id == undefined) { this.Defer("ShowMenu", button); return; }   // nothing to answer
;     this.pendingId = undefined; this.lastAnswer = button;   // LoadComplete: 0 new, 1 load
;     fscommand("SR_Log", "answer cppId=" + id + " button=" + button);
;     _global.GlobalAdapter.CppPopupComplete(id, button);   // the game's own answer path
;   } else if (button == 2) this.Defer("ShowSettings", 0);   // SETTINGS (step 7)
;   else if (button == 3) this.Defer("OpenMods", 3);          // MODS (iter-464 modmenu)
;   else if (button == 4 || button < 0) this.Defer("ShowExitConfirm");   // EXIT, or B (lane E E4, Q4 (b))
    Push [reg1]
    EA_PushConstByte 'OnMenu'
    .func2 ''(r3 'popup', r4 'button') flags=0x60129
        EA_PushConstByte 'FSCommand:SR_Log'
        EA_PushConstByte 'menu button='
        Push [reg4]
        Add2
        GetURL2
        Push [reg4]
        EA_PushZero
        Equals2
        If mn_answer
        Push [reg4]
        EA_PushOne
        Equals2
        If mn_answer
        Push [reg4]
        EA_PushByte 2
        Equals2
        Not
        If mn_notsettings
        EA_PushByte 2
        EA_PushConstByte 'OpenOptions'
        EA_PushByte 2
        Push [reg1]
        EA_CallNamedMethodPop 'Defer'
        op_76
        Return
mn_notsettings:
        Push [reg4]
        EA_PushByte 3
        Equals2
        Not
        If mn_notmods
        EA_PushByte 3
        EA_PushConstByte 'OpenMods'
        EA_PushByte 2
        Push [reg1]
        EA_CallNamedMethodPop 'Defer'
        op_76
        Return
mn_notmods:
        Push [reg4]
        EA_PushByte 4
        Equals2
        If mn_exit
        Push [reg4]
        EA_PushZero
        Less2
        Not
        If mn_end
mn_exit:
        op_76
        EA_PushConstByte 'ShowExitConfirm'
        EA_PushByte 2
        Push [reg1]
        EA_CallNamedMethodPop 'Defer'
        op_76
        Return
mn_answer:
        Push [reg1]
        EA_GetNamedMember 'pendingId'
        StoreRegister 5
        Pop
        Push [reg5]
        op_76
        Equals2
        Not
        If mn_have
        Push [reg4]
        EA_PushConstByte 'ShowMenu'
        EA_PushByte 2
        Push [reg1]
        EA_CallNamedMethodPop 'Defer'
        op_76
        Return
mn_have:
        Push [reg1]
        EA_PushConstByte 'pendingId'
        op_76
        SetMember
        Push [reg1]
        EA_PushConstByte 'lastAnswer'
        Push [reg4]
        SetMember
        EA_PushConstByte 'FSCommand:SR_Log'
        EA_PushConstByte 'answer cppId='
        Push [reg5]
        Add2
        EA_PushConstByte ' button='
        Add2
        Push [reg4]
        Add2
        GetURL2
        Push [reg4]
        Push [reg5]
        EA_PushByte 2
        Push [reg2]
        EA_GetNamedMember 'GlobalAdapter'
        EA_CallNamedMethodPop 'CppPopupComplete'
mn_end:
