        Push [reg1]
        EA_PushConstByte 'FE'
        EA_PushConstByte 'display'
        EA_PushByte 5
        Push [reg2]
        EA_GetNamedMember 'SRDevTools'
        EA_CallNamedMethodPop 'Open'
