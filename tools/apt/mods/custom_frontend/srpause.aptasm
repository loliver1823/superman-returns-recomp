        Push [reg3]
        EA_GetNamedMember 'SR_OrigHandleInput'
        op_76
        Equals2
        If pt_noinput
        Push [reg3]
        EA_PushConstByte 'HandleInput'
        Push [reg3]
        EA_GetNamedMember 'SR_OrigHandleInput'
        SetMember
        Push [reg3]
        EA_PushConstByte 'SR_OrigHandleInput'
        Delete
        Pop
pt_noinput:
        Push [reg1]
        EA_GetNamedMember 'deferId'
        op_76
        Equals2
        If pt_nodefer
        Push [reg1]
        EA_GetNamedMember 'deferId'
        EA_PushOne
        EA_PushConstByte 'clearInterval'
        CallFunction
        Pop
        Push [reg1]
        EA_PushConstByte 'deferId'
        op_76
        SetMember
pt_nodefer:
