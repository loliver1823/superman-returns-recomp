        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'ShowQuit'
        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'OnQuit'
        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'Back'
        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'OpenDevTools'
        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'OnReady'
        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'GenPopInputHook'
        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'Defer'
        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'RunDeferred'
        Delete
        Pop
        Push [reg1]
        EA_PushConstByte 'AutosaveOn'
        Delete
