# iter-466 controls2: PARITY ROLL 2 (docs/PC_CONTROLS.md 2.6, 7). The front end by the mouse (clicks
# on SETTINGS, DISPLAY OPTIONS, NEW GAME), THE REMAPPER live (PC SETTINGS > CONTROLS: ATTACK's first
# key captured as K, applied, then K attacks in gameplay), a second takeoff / land pair, and the pause
# menu and the map closed by mouse clicks.
# Run: tools/controls/play_roll.ps1 (SR_PORT_FEATURES=1, SR_HARNESS_VPAD=1, the cursor feed).
keymap legacy
await \[NAT_FE\] .256 natural FE master tick 300
tap_until RETURN 250 12000 4 \[APT_LOADMOVIE\].*\("main"\)
await \[APT_REQ\] \S+ path='\.\./common/ButtonHints/XBox360/HintB' 240
wait 10000
vplug
wait 3000
keymap player
press RETURN 300 title-enter
expect claim LoadCreate 20
ifmiss tap_try RETURN 300 3000 4 claim LoadCreate
wait 5000
# ── MAIN MENU > SETTINGS > DISPLAY OPTIONS, all by mouse clicks
cursor move 600 300
cursor move 640 320
wait 1500
cclickitem 2
expect menu button=2|MOUSE_UI\] call gEH.HandleEvent\(302\) 10
wait 4000
cursor move 600 300
cursor move 640 330
wait 1500
cclickitem 3
expect \[PC_SETTINGS\] shown 15
wait 3000
# ── THE REMAPPER: E x4 = the CONTROLS tab; down 10 = ATTACK (1 prompts row, 4 mouse rows, 5 movement rows); Enter captures, K is the new key; R applies
tap E 150
wait 600
tap E 150
wait 600
tap E 150
wait 600
tap E 150
expect \[PC_SETTINGS\] tab CONTROLS 8
wait 1500
pulse DOWN 120 400 10
wait 1500
tap RETURN 150
wait 1200
tap K 150
expect \[PC_SETTINGS\] bind bind_Attack slot 8
wait 1500
tap R 150
expect \[PC_CONTROLS\] reloaded 8
wait 2000
tap ESCAPE 150
wait 2500
# back to the MAIN MENU by a right-click (= back), then NEW GAME by a click
cursor move 600 200
cclick 640 360 right
expect MOUSE_UI\] call gEH.HandleEvent\(304\) 10
wait 3000
cursor move 640 330
wait 800
chover 0
wait 1500
cclickitem 0
expect answer cppId=\S+ button=0 10
ifmiss keymap legacy
ifmiss tap Z 250
keymap player
await \[APT_REQ\] \S+ path='screens/hud/main_hud' 180
wait 20000
await_ctx 2 300
wait 6000
# ── the rebound key: K attacks (the pad pair follows)
press K 400 key-attack
wait 2000
vpress X 400 pad-attack
wait 2500
# ── move: W (key) vs the pad's left stick (ramped, see harness_play vstick)
press W 900 key-move
wait 2000
vstick l 0 32767 900 pad-move
wait 2500
# ── takeoff / land, key then pad
press SPACE 300 key-takeoff
wait 5000
press SPACE 300 key-land
wait 6000
vpress Y 300 pad-takeoff
wait 5000
vpress Y 300 pad-land
wait 6000
# ── pause by Esc, then RESUME (row 0) by a mouse click
press ESCAPE 300 key-pause
expect SR_Log 'pause install' 10
ifmiss wait 4000
ifmiss press ESCAPE 300 key-pause-retry
ifmiss expect SR_Log 'pause install' 10
wait 3000
cursor move 600 300
cursor move 640 320
wait 1000
cclickitem 0
expect PC_CONTROLS\] context gameplay 10
wait 3000
# ── map by M, closed by a right-click
press M 300 key-map
expect PC_CONTROLS\] context menu 10
wait 3000
cursor move 600 300
cclick 640 360 right
expect PC_CONTROLS\] context gameplay 10
wait 4000
vunplug
wait 2000
